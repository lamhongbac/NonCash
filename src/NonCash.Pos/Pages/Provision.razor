@page "/provision"
@layout NonCash.Pos.Layout.PosLayout

<PageTitle>Provision Terminal — NonCash POS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-6 mt-8" Elevation="3">
        <MudText Typo="Typo.h5" Class="mb-4">Terminal Provisioning</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Enter the outlet API key to provision this terminal. This is a one-time setup —
            the key will be stored locally on this device.
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_apiKey" Label="API Key" Variant="Variant.Outlined"
                      Placeholder="e.g. a3f7b2c1" HelperText="NonCash Web → Outlets → Edit → Copy Setup Key"
                      Class="mb-4" />
        <MudTextField @bind-Value="_storeCode" Label="Store Code" Variant="Variant.Outlined"
                      Placeholder="e.g. S01" HelperText="NonCash Web → Outlets → Edit → Copy Setup Key"
                      Class="mb-4" />
        <MudTextField @bind-Value="_posNo" Label="POS Terminal No." Variant="Variant.Outlined"
                      Placeholder="e.g. POS-01" Required="true"
                      HelperText="Unique identifier for this POS terminal (e.g. POS-01, COUNTER-1)"
                      Class="mb-4" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CompleteProvisioning"
                   Disabled="@_loading" FullWidth="true">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Provision Terminal
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private ProvisioningService Provisioning { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string _apiKey = string.Empty;
    private string _storeCode = string.Empty;
    private string _posNo = string.Empty;
    private string? _error;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (await Provisioning.IsProvisionedAsync())
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task CompleteProvisioning()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_apiKey))
        {
            _error = "API Key is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_storeCode))
        {
            _error = "Store Code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_posNo))
        {
            _error = "POS Terminal No. is required.";
            return;
        }

        _loading = true;

        // No manual Outlet ID: the outlet is resolved authoritatively at staff login
        // (store code → outlet), so a mistyped GUID can never break redeem calls.
        var outlet = new ProvisionedOutlet(
            ApiKey: _apiKey.Trim(),
            StoreCode: _storeCode.Trim(),
            PosNo: _posNo.Trim()
        );

        await Provisioning.SaveOutletAsync(outlet);
        Nav.NavigateTo("/login");
    }
}

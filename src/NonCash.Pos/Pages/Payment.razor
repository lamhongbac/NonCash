@page "/payment"
@layout NonCash.Pos.Layout.PosLayout

<PageTitle>Payment — NonCash POS</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <MudAlert Severity="Severity.Warning">Session expired. Please log in again.</MudAlert>
}
else
{
<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mr-2" />Voucher Payment
            </MudText>

            @* ── Step 1: Scan / enter voucher code ── *@
            <MudTextField @bind-Value="_voucherCode" Label="Scan or paste voucher code"
                          Variant="Variant.Outlined" Immediate="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                          Placeholder="Paste the full voucher code here..."
                          HelperText="Scan the customer's rotating code from the member app (valid 2 minutes). Serial numbers (VC-...) are not scannable."
                          Class="mb-3" />

            <MudTextField @bind-Value="_billNumber" Label="Bill Number" Variant="Variant.Outlined"
                          Placeholder="Auto-generated if empty" Class="mb-3" />

            <MudTextField @bind-Value="_amountUsed" Label="Amount Used (VND)" Variant="Variant.Outlined"
                          InputType="InputType.Number" Placeholder="0" Class="mb-2"
                          HelperText="The voucher is consumed in full either way — this records how much of the bill it covered. Leave empty for the full face value." />

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">@ModeHint</MudText>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
            }

            @* ── Action buttons ── *@
            <MudStack Row Spacing="2" Class="mb-3">
                @* While a lock is held, only COMMIT / ROLLBACK / CLEAR may act —
                   starting a new verify/lock/redeem would orphan the live server lock. *@
                @if (_lockId is null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="HandleVerify"
                               Disabled="@IsVerifyDisabled">
                        @if (_loading && _action == "verify")
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Verify
                    </MudButton>

                    @if (IsOneClick)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleRedeem"
                                   Disabled="@IsRedeemDisabled">
                            @if (_loading && _action == "redeem")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Redeem
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="HandleLock"
                                   Disabled="@IsLockDisabled">
                            @if (_loading && _action == "lock")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Lock
                        </MudButton>
                    }
                }

                @if (!IsOneClick || _lockId is not null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleCommit"
                               Disabled="@IsCommitDisabled">
                        @if (_loading && _action == "commit")
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Commit
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="HandleRollback"
                               Disabled="@IsRollbackDisabled">
                        @if (_loading && _action == "rollback")
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Rollback
                    </MudButton>
                }

                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ResetForm">
                    Clear
                </MudButton>
            </MudStack>

            @if (_lockId is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <strong>This voucher is being held for bill @_billNumber.</strong>
                    Press COMMIT to finish the redemption, or ROLLBACK to release the voucher for the customer.
                    Pressing Clear or scanning a different code abandons this screen but does <strong>not</strong> release
                    the hold server-side — the voucher stays unavailable elsewhere until the hold expires on its own
                    (about 10 minutes) or you press Rollback.
                </MudAlert>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        @* ── Voucher info card ── *@
        @if (_verifyResult is not null)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2" Style="@GetResultCardStyle()">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <MudIcon Icon="@GetStatusIcon()" Color="@GetStatusColor()" Class="mr-2" />
                    @_verifyResult.Status
                </MudText>
                @if (_verifyResult.Reason is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Reason: @_verifyResult.Reason</MudText>
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        @(PosFailureReasons.Describe(_verifyResult.Reason, Auth.CurrentShift?.StoreCode))
                    </MudAlert>
                }
                @if (_verifyResult.VoucherInfo is not null)
                {
                    <MudDivider Class="my-2" />
                    <MudSimpleTable Dense="true" Hover="true">
                        <BodyContent>
                            <MudTr>
                                <MudTd>Brand</MudTd>
                                <MudTd><strong>@_verifyResult.VoucherInfo.BrandName</strong></MudTd>
                            </MudTr>
                            <MudTr>
                                <MudTd>Serial No</MudTd>
                                <MudTd><strong>@_verifyResult.VoucherInfo.SerialNo</strong></MudTd>
                            </MudTr>
                            <MudTr>
                                <MudTd>Face Value</MudTd>
                                <MudTd><strong>@_verifyResult.VoucherInfo.FaceValue.ToString("N0") VND</strong></MudTd>
                            </MudTr>
                            <MudTr>
                                <MudTd>Type</MudTd>
                                <MudTd>@_verifyResult.VoucherInfo.ValueType</MudTd>
                            </MudTr>
                            <MudTr>
                                <MudTd>Expiry</MudTd>
                                <MudTd>@_verifyResult.VoucherInfo.ExpiryDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                            </MudTr>
                            <MudTr>
                                <MudTd>Scope</MudTd>
                                <MudTd>@_verifyResult.VoucherInfo.ScopeSummary</MudTd>
                            </MudTr>
                            @if (_verifyResult.VoucherInfo.ApplicableOutlets.Count > 0)
                            {
                                <MudTr>
                                    <MudTd>Stores</MudTd>
                                    <MudTd>@(string.Join(", ", _verifyResult.VoucherInfo.ApplicableOutlets))</MudTd>
                                </MudTr>
                            }
                        </BodyContent>
                    </MudSimpleTable>
                }
                @if (_lockId is not null)
                {
                    <MudDivider Class="my-2" />
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        <strong>Locked</strong> — LockId: @_lockId.Value.ToString("N")[..8]...
                    </MudAlert>
                }
                @if (!string.IsNullOrEmpty(_commitMessage))
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">@_commitMessage</MudAlert>
                }
            </MudPaper>
        }

        @* ── Shift transactions ── *@
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-2">
                Shift Transactions (@Auth.CurrentShift!.Transactions.Count)
            </MudText>
            @if (Auth.CurrentShift.Transactions.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No transactions yet this shift.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <HeadContent>
                        <MudTr>
                            <MudTh>Time</MudTh>
                            <MudTh>Bill</MudTh>
                            <MudTh>Voucher</MudTh>
                            <MudTh Align="Align.Right">Amount</MudTh>
                            <MudTh>Status</MudTh>
                        </MudTr>
                    </HeadContent>
                    <BodyContent>
                        @foreach (var tx in Auth.CurrentShift.Transactions.AsEnumerable().Reverse())
                        {
                            <MudTr>
                                <MudTd>@tx.Timestamp.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                                <MudTd>@tx.BillNumber</MudTd>
                                <MudTd>@tx.VoucherSerialNo</MudTd>
                                <MudTd Align="Align.Right">@tx.AmountUsed.ToString("N0")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(tx.Status == "Committed" ? Color.Success : Color.Warning)">
                                        @tx.Status
                                    </MudChip>
                                </MudTd>
                            </MudTr>
                        }
                    </BodyContent>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
}

@code {
    [Inject] private PosAuthService Auth { get; set; } = default!;
    [Inject] private IPosApiClient PosApi { get; set; } = default!;
    [Inject] private RedemptionFlowService Redemption { get; set; } = default!;
    [Inject] private ProvisioningService Provisioning { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string _voucherCode = string.Empty;
    private string _billNumber = string.Empty;
    private string _amountUsed = string.Empty;
    private string? _error;
    private string? _commitMessage;
    private bool _loading;
    private string _action = string.Empty;

    private PosVerifyResponse? _verifyResult;
    private Guid? _lockId;

    private bool IsOneClick => Auth.CurrentShift?.IsOneClickRedemption ?? true;

    private string ModeHint => IsOneClick
        ? "One-click mode (this outlet): paste the code and press REDEEM — it locks and commits in one step. VERIFY is optional and does not redeem."
        : "Three-step mode (this outlet): VERIFY, then LOCK, then COMMIT. ROLLBACK releases a lock.";

    private bool IsVerifyDisabled => _loading || string.IsNullOrWhiteSpace(_voucherCode);
    private bool IsRedeemDisabled => _loading || string.IsNullOrWhiteSpace(_voucherCode);
    private bool IsLockDisabled => _loading || _verifyResult?.Status != "Valid";
    private bool IsCommitDisabled => _loading || _lockId == null;
    private bool IsRollbackDisabled => _loading || _lockId == null;

    // The server no longer holds this lock (it expired, was released, or the voucher already
    // completed), so the local LockId is stale and must not keep the screen in the held state.
    // Rollback spells the consumed state "AlreadyCompleted"; commit spells it "AlreadyComplete".
    private static bool IsDeadLockReason(string? reason) => reason is "LockExpired" or "AlreadyComplete" or "AlreadyCompleted" or "AlreadyReleased";

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn) Nav.NavigateTo("/login");
    }

    private async Task HandleVerify()
    {
        _error = null;
        _commitMessage = null;
        _verifyResult = null;
        _lockId = null;
        _loading = true;
        _action = "verify";

        try
        {
            var outlet = await Provisioning.GetOutletAsync();
            if (outlet is null) { _error = "Terminal not provisioned."; return; }

            // The outlet id sent to the API is the shift-resolved one (from staff login),
            // not the manually-provisioned value — the API key already pins the terminal.
            _verifyResult = await PosApi.VerifyAsync(_voucherCode.Trim(), Auth.CurrentShift!.OutletId);
            if (_verifyResult is null) _error = "No response from server.";
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _loading = false; _action = string.Empty; }
    }

    private async Task HandleRedeem()
    {
        _error = null;
        _commitMessage = null;
        _verifyResult = null;
        _lockId = null;
        _loading = true;
        _action = "redeem";

        try
        {
            if (await Provisioning.GetOutletAsync() is null) { _error = "Terminal not provisioned."; return; }

            var shift = Auth.CurrentShift!;
            var bill = string.IsNullOrWhiteSpace(_billNumber)
                ? $"BILL-{DateTime.Now:yyyyMMddHHmmss}"
                : _billNumber.Trim();
            _billNumber = bill;

            var txnId = $"{shift.StoreCode}-{bill}-{DateTime.UtcNow.Ticks}";
            var amount = decimal.TryParse(_amountUsed, out var typed) && typed > 0 ? typed : (decimal?)null;

            var outcome = await Redemption.RedeemAsync(
                _voucherCode.Trim(), shift.OutletId, bill, txnId, amount,
                shift.PosNo, shift.StaffUserId.ToString());

            if (outcome.Committed)
            {
                Auth.RecordTransaction(bill, outcome.VoucherInfo?.SerialNo ?? "", outcome.AmountUsed, "Committed");
                Snackbar.Add($"Voucher redeemed — {outcome.AmountUsed:N0} VND.", Severity.Success);
                ResetForm();
            }
            else
            {
                _lockId = outcome.LockId;
                _verifyResult = new PosVerifyResponse(
                    outcome.LockId is null ? "Invalid" : "Locked", outcome.Reason, outcome.VoucherInfo);
                _error = PosFailureReasons.Describe(outcome.Reason, shift.StoreCode)
                         ?? outcome.Message
                         ?? "Redemption failed. The voucher was not redeemed.";
            }
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _loading = false; _action = string.Empty; }
    }

    private async Task HandleLock()
    {
        _error = null;
        _commitMessage = null;
        _lockId = null;
        _loading = true;
        _action = "lock";

        try
        {
            if (await Provisioning.GetOutletAsync() is null) { _error = "Terminal not provisioned."; return; }
            var bill = string.IsNullOrWhiteSpace(_billNumber)
                ? $"BILL-{DateTime.Now:yyyyMMddHHmmss}"
                : _billNumber.Trim();
            _billNumber = bill;

            var result = await PosApi.LockAsync(
                _voucherCode.Trim(), Auth.CurrentShift!.OutletId, bill,
                Auth.CurrentShift!.PosNo, Auth.CurrentShift.StaffUserId.ToString());

            if (result?.Status == "Locked")
            {
                _lockId = result.LockId;
                _verifyResult = new PosVerifyResponse("Locked", null, result.VoucherInfo);
                Snackbar.Add("Voucher locked successfully", Severity.Success);
            }
            else
            {
                _error = PosFailureReasons.Describe(result?.Reason, Auth.CurrentShift?.StoreCode)
                         ?? result?.Status ?? "Lock failed";
            }
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _loading = false; _action = string.Empty; }
    }

    private async Task HandleCommit()
    {
        if (_lockId == null) return;
        _error = null;
        _commitMessage = null;
        _loading = true;
        _action = "commit";

        try
        {
            // An empty field means the bill absorbed the whole voucher, same as the Redeem path.
            // Sending 0 instead would consume the voucher while recording a breakage that never happened.
            var faceValue = _verifyResult?.VoucherInfo?.FaceValue;
            decimal amount;
            if (decimal.TryParse(_amountUsed, out var typed) && typed > 0)
            {
                amount = typed;
            }
            else if (faceValue is > 0)
            {
                amount = faceValue.Value;
            }
            else
            {
                _error = "This voucher's face value is not loaded, so the amount to record cannot be worked out "
                         + "and nothing was committed. Type the amount the bill absorbed into Amount Used, "
                         + "then press Commit again.";
                return;
            }

            var txnId = $"{Auth.CurrentShift!.StoreCode}-{_billNumber}-{DateTime.UtcNow.Ticks}";

            var result = await PosApi.CommitAsync(
                _lockId.Value, txnId, amount,
                Auth.CurrentShift.PosNo, Auth.CurrentShift.StaffUserId.ToString());

            if (result?.Status == "Success")
            {
                _commitMessage = "Voucher committed successfully!";
                _lockId = null;
                Auth.RecordTransaction(_billNumber,
                    _verifyResult?.VoucherInfo?.SerialNo ?? "", amount, "Committed");
                Snackbar.Add("Payment completed!", Severity.Success);
                ResetForm();
            }
            else
            {
                if (IsDeadLockReason(result?.Reason)) _lockId = null;
                _error = PosFailureReasons.Describe(result?.Reason, Auth.CurrentShift?.StoreCode)
                         ?? result?.Message ?? "Commit failed";
            }
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _loading = false; _action = string.Empty; }
    }

    private async Task HandleRollback()
    {
        if (_lockId == null) return;
        _error = null;
        _commitMessage = null;
        _loading = true;
        _action = "rollback";

        try
        {
            var result = await PosApi.RollbackAsync(_lockId.Value);
            if (result?.Status == "Success" || result?.Status == "AlreadyReleased")
            {
                Auth.RecordTransaction(_billNumber,
                    _verifyResult?.VoucherInfo?.SerialNo ?? "", 0, "RolledBack");
                Snackbar.Add("Voucher rolled back", Severity.Info);
                ResetForm();
            }
            else
            {
                if (IsDeadLockReason(result?.Reason)) _lockId = null;
                _error = PosFailureReasons.Describe(result?.Reason, Auth.CurrentShift?.StoreCode)
                         ?? result?.Message ?? "Rollback failed";
            }
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _loading = false; _action = string.Empty; }
    }

    private void ResetForm()
    {
        _voucherCode = string.Empty;
        _billNumber = string.Empty;
        _amountUsed = string.Empty;
        _verifyResult = null;
        _lockId = null;
        _error = null;
        _commitMessage = null;
    }

    private string GetResultCardStyle() => _verifyResult?.Status switch
    {
        "Valid" => "border-left: 4px solid #4caf50;",
        "Locked" => "border-left: 4px solid #ff9800;",
        "Invalid" => "border-left: 4px solid #f44336;",
        _ => ""
    };

    private string GetStatusIcon() => _verifyResult?.Status switch
    {
        "Valid" => Icons.Material.Filled.CheckCircle,
        "Locked" => Icons.Material.Filled.Lock,
        "Invalid" => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Help
    };

    private Color GetStatusColor() => _verifyResult?.Status switch
    {
        "Valid" => Color.Success,
        "Locked" => Color.Warning,
        "Invalid" => Color.Error,
        _ => Color.Default
    };
}

@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Auth.IsLoggedIn)
{
    <MudLayout>
        <MudAppBar Dense="true" Color="Color.Primary" Elevation="1" Fixed="false">
            <MudText Typo="Typo.h6" Class="ml-3">NonCash POS</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mr-3">
                @Auth.CurrentShift!.StaffName &middot; @Auth.CurrentShift.StoreCode
            </MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mr-2">
                Shift ends: @Auth.CurrentShift.TokenExpiry.ToLocalTime().ToString("HH:mm")
            </MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                           OnClick="EndShift" Title="End Shift" />
        </MudAppBar>
        <MudMainContent Class="pa-4">
            @Body
        </MudMainContent>
    </MudLayout>
}
else
{
    <MudLayout>
        <MudAppBar Dense="true" Color="Color.Primary" Elevation="1" Fixed="false">
            <MudText Typo="Typo.h6" Class="ml-3">NonCash POS</MudText>
        </MudAppBar>
        <MudMainContent Class="pa-4">
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    [Inject] private PosAuthService Auth { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976d2",
            Secondary = "#ff9800",
            AppbarBackground = "#1976d2"
        }
    };

    private void EndShift()
    {
        Auth.EndShift();
        Nav.NavigateTo("/login");
    }
}

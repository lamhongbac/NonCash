<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(NonCash.Pos.Pages.Login).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(NonCash.Pos.Layout.PosLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(NonCash.Pos.Layout.PosLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

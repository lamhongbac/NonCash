@inject HttpClient Http
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NonCash.Web.Services.ClientAuthService AuthState
@using NonCash.Infrastructure.Services

@*
    Reusable "Batch Promotion" (Story 3.1) distribution card.
    Embedded wherever vouchers of an approved plan can be sent to customers:
      - after Generate Vouchers (PlanVouchers.razor)
      - the standalone "Distribute Vouchers" menu page (Distribute.razor)
      - (later) the read-only plan View
    Set PlanId; optionally handle OnDistributed to refresh the host page.
*@

<MudPaper Class="pa-4 mb-4" Elevation="2">
    @if (ShowHeader)
    {
        <MudText Typo="Typo.h6" GutterBottom="true">Batch Promotion (Story 3.1)</MudText>
    }
    <MudText Typo="Typo.body2" Class="mb-3">Distribute vouchers to a target customer list. Paste phone numbers and/or email addresses (comma/newline separated) or upload a file with them in the first column — <b>.xlsx</b> (recommended, use the template) or .csv/.txt. Each recipient must match an <b>existing customer</b> (by phone or email) — unknown, blacklisted or blocked entries are skipped automatically, and duplicate entries receive only one voucher.</MudText>

    @if (_stockLoaded)
    {
        <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2"><b>Plan:</b> @(string.IsNullOrEmpty(_stockPlanName) ? "(this plan)" : _stockPlanName)</MudText>
                <MudText Typo="Typo.body2"><b>Generated:</b> @_stockGenerated</MudText>
                <MudText Typo="Typo.body2"><b>Assigned/Used:</b> @_stockAssignedUsed</MudText>
                <MudText Typo="Typo.body2"><b>Available:</b> @_stockAvailable</MudText>
                <MudText Typo="Typo.body2"><b>Quota remaining:</b> @_stockQuotaRemaining</MudText>
            </MudStack>
        </MudPaper>
    }

    <MudStack Spacing="2">
        <MudTextField T="string" @bind-Value="_phoneList" Label="Phone numbers / email addresses" Lines="4" Variant="Variant.Outlined" Placeholder="0912345678, jane@example.com" />
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Notify recipients via:</MudText>
            <MudRadioGroup T="string" @bind-Value="_notifyChannel">
                <MudRadio T="string" Value="@("Email")" Color="Color.Primary" Dense="true">Email</MudRadio>
                <MudRadio T="string" Value="@("Zalo")" Color="Color.Primary" Dense="true">Zalo</MudRadio>
                <MudRadio T="string" Value="@("Both")" Color="Color.Primary" Dense="true">Both</MudRadio>
            </MudRadioGroup>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadRecipientTemplate">
                Download template
            </MudButton>
            <InputFile OnChange="OnFileSelected" accept=".csv,.txt,.xlsx" />
            @if (_selectedFile != null)
            {
                <MudText Typo="Typo.caption">Selected: @_selectedFile.Name</MudText>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="PromoteVouchers" Disabled="@(_promoting || PlanId == Guid.Empty)" StartIcon="@Icons.Material.Filled.Campaign">
                @if (_promoting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Distribute Now
            </MudButton>
        </MudStack>

        @if (_stockLoaded && ParsedRecipientCount > 0)
        {
            var after = _stockAvailable - ParsedRecipientCount;
            <MudText Typo="Typo.body2"
                     Color="@(ParsedRecipientCount > _stockAvailable ? Color.Error : Color.Default)"
                     Class="@(ParsedRecipientCount > _stockAvailable ? "mt-1" : "mt-1")">
                You will send to <b>@ParsedRecipientCount</b> recipient@(ParsedRecipientCount == 1 ? "" : "s");
                <b>@_stockAvailable</b> available; after = <b>@after</b>.
                @if (ParsedRecipientCount > _stockAvailable)
                {
                    <span>Not enough available vouchers — generate more or reduce the list.</span>
                }
            </MudText>
        }
    </MudStack>

    @if (_lastPromoteResult != null)
    {
        <MudAlert Severity="@(_lastPromoteResult.SkippedCount > 0 ? Severity.Warning : Severity.Success)" Class="mt-3">
            Distributed: <b>@_lastPromoteResult.DistributedCount</b> &nbsp;|&nbsp; Skipped: <b>@_lastPromoteResult.SkippedCount</b>
        </MudAlert>
        @if (_lastPromoteResult.SkippedPhones?.Any() == true)
        {
            <MudTable Items="_lastPromoteResult.SkippedPhones" Dense="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>Phone</MudTh>
                    <MudTh>Reason</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PhoneNumber</MudTd>
                    <MudTd>@context.Reason</MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</MudPaper>

@code {
    /// <summary>The approved plan whose vouchers are distributed.</summary>
    [Parameter] public Guid PlanId { get; set; }

    /// <summary>Raised after a successful distribution so the host page can refresh (e.g. reload voucher list).</summary>
    [Parameter] public EventCallback OnDistributed { get; set; }

    /// <summary>Shows the "Batch Promotion" title. Turn off when the host already provides a heading.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    private string _phoneList = string.Empty;
    private string _notifyChannel = "Email";
    private IBrowserFile? _selectedFile;
    private bool _promoting = false;
    private PromoteResultDto? _lastPromoteResult;
    private Guid _lastPlanId;

    // Recipients parsed from the uploaded file (kept so we can show the count before submit).
    private List<string> _fileRecipients = new();

    // Stock snapshot for the selected plan (from GET api/v1/plans/{id}).
    private bool _stockLoaded = false;
    private string _stockPlanName = string.Empty;
    private int _stockGenerated;
    private int _stockAssignedUsed;
    private int _stockAvailable;
    private int _stockQuotaRemaining;

    /// <summary>
    /// Distinct valid recipient tokens across the uploaded file and the pasted list.
    /// Used to show "you will send to R recipients" and to pre-block R &gt; available.
    /// </summary>
    private int ParsedRecipientCount
    {
        get
        {
            var tokens = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var t in _fileRecipients)
                if (!string.IsNullOrWhiteSpace(t)) tokens.Add(t.Trim());
            foreach (var t in _phoneList.Split(new[] { ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                if (!string.IsNullOrWhiteSpace(t)) tokens.Add(t.Trim());
            return tokens.Count;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reset transient state when a different plan is selected (the standalone Distribute page reuses this component).
        if (PlanId != _lastPlanId)
        {
            _lastPlanId = PlanId;
            _phoneList = string.Empty;
            _notifyChannel = "Email";
            _selectedFile = null;
            _fileRecipients = new();
            _promoting = false;
            _lastPromoteResult = null;
            await LoadStockAsync();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _fileRecipients = new();
        if (_selectedFile == null) return;
        try
        {
            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            _fileRecipients = await RecipientFileReader.ReadAsync(stream);
        }
        catch (Exception ex)
        {
            _fileRecipients = new();
            await MessageDialog.ShowAsync(DialogService, "Could not read the file",
                ex.Message, Severity.Error);
        }
    }

    private async Task LoadStockAsync()
    {
        _stockLoaded = false;
        if (PlanId == Guid.Empty) return;
        try
        {
            var request = await CreateAuthRequestAsync(HttpMethod.Get, $"api/v1/plans/{PlanId}");
            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode) return;
            var info = await response.Content.ReadFromJsonAsync<PlanStockInfo>();
            if (info == null) return;
            _stockPlanName = string.IsNullOrWhiteSpace(info.DisplayName) ? info.VoucherType ?? string.Empty : info.DisplayName!;
            _stockGenerated = info.Generated;
            _stockAssignedUsed = info.AssignedUsed;
            _stockAvailable = info.Available;
            _stockQuotaRemaining = info.QuotaRemaining;
            _stockLoaded = true;
        }
        catch
        {
            // Stock panel is informational; if it cannot load we still allow the server to validate authoritatively.
            _stockLoaded = false;
        }
    }

    private async Task<HttpRequestMessage> CreateAuthRequestAsync(HttpMethod method, string url)
    {
        var request = new HttpRequestMessage(method, url);
        var token = await AuthState.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return request;
    }

    private async Task PromoteVouchers()
    {
        if (_selectedFile == null && string.IsNullOrWhiteSpace(_phoneList))
        {
            await MessageDialog.ShowAsync(DialogService, "Nothing to distribute",
                "Please paste phone numbers/email addresses or upload a recipient file first.",
                Severity.Warning);
            return;
        }

        // Client-side pre-check (server re-checks authoritatively). Block before any request is sent.
        var recipients = ParsedRecipientCount;
        if (_stockLoaded && recipients > _stockAvailable)
        {
            await MessageDialog.ShowAsync(DialogService, "Nothing was distributed",
                $"Required {recipients}, Available {_stockAvailable} ({_stockAssignedUsed} already assigned/used). " +
                "Generate more vouchers for this plan or reduce the recipient list.",
                Severity.Error);
            return;
        }

        _promoting = true;
        _lastPromoteResult = null;
        try
        {
            var token = await AuthState.GetTokenAsync();
            using var content = new MultipartFormDataContent();

            if (_selectedFile != null)
            {
                var streamContent = new StreamContent(_selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
                var mediaType = _selectedFile.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)
                    ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                    : "text/csv";
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mediaType);
                content.Add(streamContent, "file", _selectedFile.Name);
            }

            if (!string.IsNullOrWhiteSpace(_phoneList))
            {
                content.Add(new StringContent(_phoneList), "phoneNumbersCsv");
            }

            content.Add(new StringContent(_notifyChannel), "notifyChannels");

            var request = new HttpRequestMessage(HttpMethod.Post, $"api/v1/plans/{PlanId}/promote") { Content = content };
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                _lastPromoteResult = await response.Content.ReadFromJsonAsync<PromoteResultDto>();
                _phoneList = string.Empty;
                _selectedFile = null;
                _fileRecipients = new();
                await LoadStockAsync();
                await OnDistributed.InvokeAsync();
                await MessageDialog.ShowAsync(DialogService, "Distribution complete",
                    $"Distributed: {_lastPromoteResult?.DistributedCount ?? 0}\nSkipped: {_lastPromoteResult?.SkippedCount ?? 0}",
                    Severity.Success);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                await MessageDialog.ShowAsync(DialogService, "Distribution failed",
                    ExtractErrorMessage(body), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "Distribution failed",
                ex.Message, Severity.Error);
        }
        finally
        {
            _promoting = false;
        }
    }

    private async Task DownloadRecipientTemplate()
    {
        try
        {
            var bytes = RecipientListTemplate.BuildXlsx();
            await JS.InvokeVoidAsync("downloadFromBase64",
                "recipient-list-template.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "Could not build the template",
                ex.Message, Severity.Error);
        }
    }

    private static string ExtractErrorMessage(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var message) && message.ValueKind == System.Text.Json.JsonValueKind.String)
                return message.GetString() ?? body;
            if (doc.RootElement.TryGetProperty("error", out var error) && error.ValueKind == System.Text.Json.JsonValueKind.String)
                return error.GetString() ?? body;
        }
        catch
        {
            // not JSON - show the raw body
        }
        return body;
    }

    public class PromoteResultDto
    {
        public int DistributedCount { get; set; }
        public int SkippedCount { get; set; }
        public List<SkippedPhoneDto>? SkippedPhones { get; set; }
    }

    public class SkippedPhoneDto
    {
        public string PhoneNumber { get; set; } = "";
        public string Reason { get; set; } = "";
    }

    /// <summary>Subset of the plan response used to render the stock panel.</summary>
    public class PlanStockInfo
    {
        public string? DisplayName { get; set; }
        public string? VoucherType { get; set; }
        public int TargetQuantity { get; set; }
        public int Generated { get; set; }
        public int AssignedUsed { get; set; }
        public int Available { get; set; }
        public int QuotaRemaining { get; set; }
    }
}

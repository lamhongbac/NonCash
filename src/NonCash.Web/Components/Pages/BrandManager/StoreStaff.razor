@page "/brandmanager/store-staff"
@attribute [StreamRendering]
@attribute [Authorize(Roles = "BrandManager")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Store Staff</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Store Staff Management</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="9" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadStaff">Refresh</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="OpenCreateDialog" Class="ml-2">Add Staff</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_staff is not null)
{
    <MudTable Items="_staff" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Username</MudTh>
            <MudTh>Full Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Assigned Outlets</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Username">@context.Username</MudTd>
            <MudTd DataLabel="Full Name">@context.FullName</MudTd>
            <MudTd DataLabel="Email">@(context.Email ?? "—")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Outlets">
                @foreach (var o in context.Outlets)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                        @(!string.IsNullOrEmpty(o.Code) ? $"{o.Code} — {o.Name}" : o.Name)
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => OpenEditDialog(context)" />
                @if (context.Status == "Active")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" OnClick="() => LockStaff(context)" Title="Lock account" />
                }
                else if (context.Status == "Locked")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Color="Color.Success" OnClick="() => UnlockStaff(context)" Title="Unlock account" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => OpenDeleteConfirm(context)" Title="Delete" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Create / Edit Dialog *@
<MudDialog @bind-Visible="_showDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Edit Staff" : "Create Staff")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Username" Label="Username" Required="true"
                          RequiredError="Username is required" Disabled="@_isEdit" Class="mb-2" />
            @if (!_isEdit)
            {
                <MudTextField @bind-Value="_model.Password" Label="Password" InputType="InputType.Password"
                              Required="true" RequiredError="Password is required" Class="mb-2" />
            }
            else
            {
                <MudTextField @bind-Value="_model.Password" Label="New Password (leave blank to keep)" InputType="InputType.Password" Class="mb-2" />
            }
            <MudTextField @bind-Value="_model.FullName" Label="Full Name" Required="true"
                          RequiredError="Full name is required" Class="mb-2" />
            <MudTextField @bind-Value="_model.Email" Label="Email" Class="mb-2" />

            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Assigned Outlets</MudText>
            @if (_allOutlets is not null && _allOutlets.Count > 0)
            {
                <MudSelect T="Guid" SelectedValues="_selectedOutletIds" SelectedValuesChanged="OnOutletSelectionChanged" Label="Select outlets" MultiSelection="true"
                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var outlet in _allOutlets)
                    {
                        <MudSelectItem Value="@outlet.Id">
                            @(!string.IsNullOrEmpty(outlet.Code) ? $"{outlet.Code} — {outlet.Name}" : outlet.Name)
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText Color="Color.Warning">No outlets found. Create outlets first.</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDialog = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveStaff">Save</MudButton>
    </DialogActions>
</MudDialog>

@* Delete Confirm Dialog *@
<MudDialog @bind-Visible="_showDeleteConfirm" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Staff</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete staff '@(_staffToDelete?.Username)'? This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDeleteConfirm = false">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="ConfirmDelete">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading;
    private List<StaffDto>? _staff;
    private List<OutletListItem>? _allOutlets;
    private IReadOnlyCollection<Guid> _selectedOutletIds = Array.Empty<Guid>();

    private bool _showDialog;
    private bool _isEdit;
    private MudForm? _form;
    private StaffFormModel _model = new();
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    private StaffDto? _staffToDelete;
    private bool _showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadStaff(), LoadOutlets());
    }

    private void OnOutletSelectionChanged(IEnumerable<Guid> values)
    {
        _selectedOutletIds = values.ToList();
    }

    private async Task LoadStaff()
    {
        _loading = true;
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, "api/v1/store-staff");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            _staff = await response.Content.ReadFromJsonAsync<List<StaffDto>>() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load staff: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadOutlets()
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, "api/v1/outlets?pageNumber=1&pageSize=200");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<PagedResult<OutletListItem>>();
            _allOutlets = result?.Items.ToList() ?? new();
        }
        catch
        {
            _allOutlets = new();
        }
    }

    private void OpenCreateDialog()
    {
        _isEdit = false;
        _model = new StaffFormModel();
        _selectedOutletIds = Array.Empty<Guid>();
        _showDialog = true;
    }

    private void OpenEditDialog(StaffDto staff)
    {
        _isEdit = true;
        _model = new StaffFormModel
        {
            Id = staff.Id,
            Username = staff.Username,
            FullName = staff.FullName,
            Email = staff.Email
        };
        _selectedOutletIds = staff.Outlets.Select(o => o.Id).ToList();
        _showDialog = true;
    }

    private async Task SaveStaff()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        if (!_selectedOutletIds.Any())
        {
            Snackbar.Add("At least one outlet must be assigned.", Severity.Warning);
            return;
        }

        try
        {
            var token = await AuthState.GetTokenAsync();
            HttpResponseMessage response;

            if (_isEdit)
            {
                var body = new
                {
                    fullName = _model.FullName,
                    email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email,
                    password = string.IsNullOrWhiteSpace(_model.Password) ? null : _model.Password,
                    outletIds = _selectedOutletIds.ToList()
                };
                var httpRequest = new HttpRequestMessage(HttpMethod.Put, $"api/v1/store-staff/{_model.Id}")
                { Content = JsonContent.Create(body) };
                if (!string.IsNullOrEmpty(token))
                    httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                response = await Http.SendAsync(httpRequest);
            }
            else
            {
                var body = new
                {
                    username = _model.Username,
                    password = _model.Password,
                    fullName = _model.FullName,
                    email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email,
                    outletIds = _selectedOutletIds.ToList()
                };
                var httpRequest = new HttpRequestMessage(HttpMethod.Post, "api/v1/store-staff")
                { Content = JsonContent.Create(body) };
                if (!string.IsNullOrEmpty(token))
                    httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                response = await Http.SendAsync(httpRequest);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(_isEdit ? "Staff updated." : "Staff created.", Severity.Success);
                _showDialog = false;
                await LoadStaff();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Save failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task LockStaff(StaffDto staff)
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/v1/store-staff/{staff.Id}/lock");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"'{staff.Username}' locked.", Severity.Success);
                await LoadStaff();
            }
            else
            {
                Snackbar.Add($"Lock failed: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private async Task UnlockStaff(StaffDto staff)
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/v1/store-staff/{staff.Id}/unlock");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"'{staff.Username}' unlocked.", Severity.Success);
                await LoadStaff();
            }
            else
            {
                Snackbar.Add($"Unlock failed: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private void OpenDeleteConfirm(StaffDto staff) { _staffToDelete = staff; _showDeleteConfirm = true; }

    private async Task ConfirmDelete()
    {
        if (_staffToDelete == null) return;
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/v1/store-staff/{_staffToDelete.Id}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"'{_staffToDelete.Username}' deleted.", Severity.Success);
                await LoadStaff();
            }
            else
            {
                Snackbar.Add($"Delete failed: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _showDeleteConfirm = false; _staffToDelete = null; }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Locked" => Color.Warning,
        _ => Color.Default
    };

    // --- DTOs ---
    public class StaffDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Status { get; set; } = string.Empty;
        public List<OutletDto> Outlets { get; set; } = new();
        public DateTime CreatedAt { get; set; }
        public DateTime? UpdatedAt { get; set; }
    }

    public class OutletDto
    {
        public Guid Id { get; set; }
        public string? Code { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    public class OutletListItem
    {
        public Guid Id { get; set; }
        public string? Code { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    public class PagedResult<T>
    {
        public IReadOnlyList<T> Items { get; set; } = Array.Empty<T>();
        public int TotalCount { get; set; }
    }

    public class StaffFormModel
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
    }
}

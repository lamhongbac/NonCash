@page "/brandmanager/plans/{PlanId:guid}/vouchers"
@attribute [Authorize(Roles = "BrandManager")]
@inject HttpClient Http
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Voucher Details</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Voucher Details</MudText>
    <MudButton Color="Color.Default" Variant="Variant.Text" Href="/brandmanager/plans">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" /> Back to Plans
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">Generate Vouchers</MudText>
        @if (!string.IsNullOrEmpty(_planName))
        {
            <MudText Typo="Typo.body2" Class="mb-2"><b>Plan:</b> @_planName</MudText>
        }
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mb-2">
            <MudText Typo="Typo.body2"><b>Target quantity:</b> @_targetQuantity</MudText>
            <MudText Typo="Typo.body2"><b>Already generated:</b> @_vouchers.Count</MudText>
            <MudText Typo="Typo.body2"><b>Remaining generatable:</b> @_remaining</MudText>
            <MudText Typo="Typo.body2"><b>Available stock:</b> @_available (pending + unassigned)</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mb-3">Generate voucher details for this approved plan. Each voucher gets a unique serial number and a dynamic security code.</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
            <MudNumericField T="int" @bind-Value="_quantity" Label="Quantity" Min="1" Max="@Math.Max(1, _remaining)" Adornment="Adornment.End" AdornmentText="vouchers" Style="max-width: 250px;" />
            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="GenerateVouchers" Disabled="@(_generating || _remaining <= 0)">
                @if (_generating)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Generate
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">Credits were already charged once at approval — generating does not charge again.</MudText>
        @if (_remaining <= 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">All approved vouchers have been generated for this plan.</MudAlert>
        }
    </MudPaper>

    <DistributeVouchers PlanId="@PlanId" OnDistributed="LoadVouchers" />

    @if (_vouchers.Any())
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Generated Vouchers (@_vouchers.Count)</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="LoadVouchers">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-1" /> Refresh Codes
                </MudButton>
            </MudStack>
            <MudTable Items="@_vouchers" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Serial No</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Recipient</MudTh>
                    <MudTh>Method</MudTh>
                    <MudTh>Distributed At</MudTh>
                    <MudTh>Dynamic Code</MudTh>
                    <MudTh>Used Date</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SerialNo</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@VoucherStatusDisplay.ChipColor(context.Status)" Size="Size.Small">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd>@RecipientLabel(context)</MudTd>
                    <MudTd>@(context.DistributionMethod ?? "-")</MudTd>
                    <MudTd>@(context.DistributedAt.HasValue ? context.DistributedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</MudTd>
                    <MudTd><MudText Typo="Typo.body2" Style="font-family:monospace; font-size:0.75rem; word-break:break-all;">@context.VoucherCode</MudText></MudTd>
                    <MudTd>@(context.UsedDate.HasValue ? context.UsedDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info">No vouchers generated yet for this plan.</MudAlert>
    }
}

@code {
    [Parameter] public Guid PlanId { get; set; }

    private List<VoucherDetailItem> _vouchers = new();
    private bool _loading = true;
    private bool _generating = false;
    private int _quantity = 1;
    private int _targetQuantity;
    private int _remaining;
    private string _planName = "";
    private int _available;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlan();
        await LoadVouchers();
        RecalcRemaining();
    }

    private async Task LoadPlan()
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/v1/plans/{PlanId}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var plan = await response.Content.ReadFromJsonAsync<PlanSummary>();
                if (plan != null)
                {
                    _targetQuantity = plan.TargetQuantity;
                    _planName = plan.DisplayName ?? "";
                    _available = plan.Available;
                }
            }
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "Could not load plan", ex.Message, Severity.Error);
        }
    }

    private void RecalcRemaining()
    {
        _remaining = Math.Max(0, _targetQuantity - _vouchers.Count);
        _quantity = Math.Max(1, _remaining);
    }

    private async Task LoadVouchers()
    {
        _loading = true;
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/v1/plans/{PlanId}/vouchers");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<VoucherDetailItem>>();
                _vouchers = result ?? new();
            }
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "Could not load vouchers", ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GenerateVouchers()
    {
        _generating = true;
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Post, $"api/v1/plans/{PlanId}/generate")
            {
                Content = JsonContent.Create(new { Quantity = _quantity })
            };
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GenerateResult>();
                var n = result?.GeneratedCount ?? 0;
                await LoadPlan();
                await LoadVouchers();
                RecalcRemaining();
                await MessageDialog.ShowAsync(DialogService, "Vouchers generated",
                    $"Successfully generated {n} voucher(s).\n\nRemaining generatable: {_remaining}.\nAvailable stock: {_available}.\nCredits were already charged at approval — nothing extra was deducted.",
                    Severity.Success);
            }
            else
            {
                var error = await ReadErrorAsync(response);
                await MessageDialog.ShowAsync(DialogService, "Generation failed", error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "Generation failed", ex.Message, Severity.Error);
        }
        finally
        {
            _generating = false;
        }
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        var raw = await response.Content.ReadAsStringAsync();
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("message", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                return m.GetString() ?? raw;
            if (doc.RootElement.TryGetProperty("error", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.String)
                return e.GetString() ?? raw;
        }
        catch
        {
            // not JSON — show the raw body
        }
        return raw;
    }

    public class VoucherDetailItem
    {
        public Guid Id { get; set; }
        public string SerialNo { get; set; } = "";
        public string Status { get; set; } = "";
        public string VoucherCode { get; set; } = "";
        public DateTime? UsedDate { get; set; }
        public string? RecipientPhone { get; set; }
        public string? RecipientName { get; set; }
        public string? DistributionMethod { get; set; }
        public DateTime? DistributedAt { get; set; }
        public Guid? BatchId { get; set; }
    }

    private static string RecipientLabel(VoucherDetailItem voucher)
    {
        var name = string.IsNullOrWhiteSpace(voucher.RecipientName) ? null : voucher.RecipientName;
        var phone = string.IsNullOrWhiteSpace(voucher.RecipientPhone) ? null : voucher.RecipientPhone;
        return (name, phone) switch
        {
            (not null, not null) => $"{name} ({phone})",
            (not null, null) => name!,
            (null, not null) => phone!,
            _ => "-", // still in stock
        };
    }

    public class GenerateResult
    {
        public int GeneratedCount { get; set; }
    }

    public class PlanSummary
    {
        public string? DisplayName { get; set; }
        public int TargetQuantity { get; set; }
        public int Available { get; set; }
    }
}

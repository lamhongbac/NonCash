@page "/brandmanager/distribute"
@attribute [Authorize(Roles = "BrandManager")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Distribute Vouchers</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Distribute Vouchers</MudText>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Select an approved plan</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">Pick an approved plan, then distribute its vouchers below. Vouchers must be generated for the plan first (see Generate Vouchers).</MudText>
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="ma-4" />
    }
    else if (!_plans.Any())
    {
        <MudAlert Severity="Severity.Info">No approved plans available for distribution.</MudAlert>
    }
    else
    {
        <MudSelect T="Guid" Label="Voucher plan" @bind-Value="_selectedPlanId" Variant="Variant.Outlined"
                   Placeholder="Select an approved plan..." ToStringFunc="@(id => PlanLabel(id))" Style="max-width: 640px;">
            @foreach (var plan in _plans)
            {
                <MudSelectItem T="Guid" Value="@plan.Id">@PlanLabel(plan.Id)</MudSelectItem>
            }
        </MudSelect>
    }
</MudPaper>

@if (_selectedPlanId != Guid.Empty)
{
    <DistributeVouchers PlanId="@_selectedPlanId" ShowHeader="false" />
}

@code {
    private List<PlanOption> _plans = new();
    private Guid _selectedPlanId;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlans();
    }

    private async Task LoadPlans()
    {
        _loading = true;
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, "api/v1/plans?status=Approved");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<PlanOption>>();
                _plans = result ?? new();
            }
            else
            {
                Snackbar.Add($"Failed to load plans: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string PlanLabel(Guid id)
    {
        var p = _plans.FirstOrDefault(x => x.Id == id);
        if (p == null) return string.Empty;
        return $"{p.VoucherType} Voucher - Qty {p.TargetQuantity}, {p.FaceValue:N0} VND, pub {p.PublishDate.ToLocalTime():dd/MM/yyyy}";
    }

    public class PlanOption
    {
        public Guid Id { get; set; }
        public string VoucherType { get; set; } = "";
        public int TargetQuantity { get; set; }
        public decimal FaceValue { get; set; }
        public DateTime PublishDate { get; set; }
    }
}

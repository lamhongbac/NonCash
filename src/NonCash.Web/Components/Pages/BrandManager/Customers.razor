@page "/brandmanager/customers"
@attribute [StreamRendering]
@attribute [Authorize(Roles = "BrandManager")]
@using NonCash.Infrastructure.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Customer Management</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Customer Management</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_searchText" Label="Search" Placeholder="Name, email or phone"
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" OnKeyDown="OnSearchKeyDown" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_searchStatus" Label="Status" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@((string?)"Active")">Active</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadCustomers">Search</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="OpenCreateDialog" Class="ml-2">Add</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="OpenImportDialog" Class="ml-2">Import</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_customers is not null)
{
    <MudTable Items="_customers" Hover="true" Breakpoint="Breakpoint.Sm">
        <NoRecordsContent>
            <MudText Class="pa-4" Align="Align.Center">No customers yet — use Add or Import to create your first customer.</MudText>
        </NoRecordsContent>
        <HeaderContent>
            <MudTh>Phone</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Phone">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Name">@context.FullName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsBrandBlocked == true)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Blocked (this brand)</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.ConfirmationNumber" Color="Color.Info"
                               OnClick="() => OpenVoucherHistory(context)" title="Voucher history" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => OpenEditDialog(context)" />
                @if (context.IsBrandBlocked == true)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" OnClick="() => UnblockCustomer(context)" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Error" OnClick="() => BlockCustomer(context)" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_totalCount > 0)
    {
        <MudPagination Count="GetPageCount()" Selected="_pageNumber" SelectedChanged="OnPageChanged" Class="mt-4" />
    }
}

<MudDialog @bind-Visible="_showDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Edit Customer" : "Create Customer")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isEdit)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Customer records are shared platform-wide. You can only fill in empty details —
                existing values are kept. For corrections, contact the platform admin.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                If this phone already exists on the platform, the customer is linked to your brand;
                existing name/email are kept — only empty details are filled.
            </MudAlert>
        }
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.PhoneNumber" Label="Phone Number" Required="true" RequiredError="Phone is required" Disabled="_isEdit" />
            <MudTextField @bind-Value="_model.FullName" Label="Full Name" Required="true" RequiredError="Name is required" Disabled="@(_isEdit && _nameLocked)"
                          HelperText="@(_isEdit && _nameLocked ? "Set platform-wide — only the platform admin can change it." : null)" />
            <MudTextField @bind-Value="_model.Email" Label="Email" Disabled="@(_isEdit && _emailLocked)"
                          HelperText="@(_isEdit && _emailLocked ? "Set platform-wide — only the platform admin can change it." : null)" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDialog = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveCustomer">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showImportDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Import Customers</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadTemplate">
                        Download Excel template
                    </MudButton>
                    <MudText Typo="Typo.body2">Fill in your customers (Phone, FullName, Email) and upload the filled file below.</MudText>
                </MudStack>
            </MudAlert>
            <MudText Typo="Typo.body2">Accepted files: <b>.xlsx</b> (recommended) or <b>.csv</b> (comma, semicolon or tab separated; header row optional).</MudText>
            <MudText Typo="Typo.body2">Imported customers join the shared platform identity; your brand keeps exclusive rights to its list and activity data.</MudText>
            <InputFile OnChange="LoadFiles" accept=".csv,.xlsx" />
        </MudStack>
        @if (!string.IsNullOrEmpty(_importFileName))
        {
            <MudText Typo="Typo.caption" Class="mt-2">Selected: @_importFileName</MudText>
        }
        @if (_importResult is not null)
        {
            <MudAlert Severity="@(_importResult.ErrorCount == 0 ? Severity.Success : Severity.Warning)" Class="mt-4">
                Import finished — <b>@_importResult.Created</b> created, <b>@_importResult.Updated</b> updated,
                <b>@_importResult.Unchanged</b> unchanged, <b>@_importResult.SkippedCount</b> row(s) kept existing values,
                <b>@_importResult.ErrorCount</b> error(s).
            </MudAlert>
            @if (_importResult.Skipped.Any())
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                    <MudButton Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadSkippedLog">
                        Download skipped log (CSV)
                    </MudButton>
                    <MudText Typo="Typo.caption">Rows where your values differed from the platform record — existing values were kept (fill-empty-only).</MudText>
                </MudStack>
                <MudList T="string" Dense="true" Class="mt-2" Style="max-height: 200px; overflow-y: auto;">
                    @foreach (var skip in _importResult.Skipped.Take(10))
                    {
                        var skipText = $"Row {skip.Row}: {skip.Message} — {skip.PhoneNumber} / {skip.FullName}";
                        <MudListItem T="string" Icon="@Icons.Material.Filled.SyncAlt" IconColor="Color.Warning" Text="@skipText" />
                    }
                </MudList>
                @if (_importResult.SkippedCount > 10)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">… and @(_importResult.SkippedCount - 10) more — see the CSV log.</MudText>
                }
            }
            @if (_importResult.Errors.Any())
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadErrorLog">
                        Download error log (CSV)
                    </MudButton>
                    <MudText Typo="Typo.caption">Full failed rows with reasons, ready for fixing and re-import.</MudText>
                </MudStack>
                <MudList T="string" Dense="true" Class="mt-2" Style="max-height: 240px; overflow-y: auto;">
                    @foreach (var error in _importResult.Errors.Take(10))
                    {
                        var errorText = $"Row {error.Row}: {error.Message} — {error.PhoneNumber} / {error.FullName}";
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Error" IconColor="Color.Error" Text="@errorText" />
                    }
                </MudList>
                @if (_importResult.ErrorCount > 10)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">… and @(_importResult.ErrorCount - 10) more — see the CSV log.</MudText>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showImportDialog = false">Close</MudButton>
        <MudButton Color="Color.Primary" OnClick="UploadImport" Disabled="@(_importFile == null)">Upload</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = false;
    private List<CustomerDto>? _customers;
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalCount = 0;
    private string? _searchText;
    private string? _searchStatus;

    private bool _showDialog = false;
    private bool _isEdit = false;
    private bool _nameLocked = false;
    private bool _emailLocked = false;
    private MudForm? _form;
    private CustomerFormModel _model = new();
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true };

    private bool _showImportDialog = false;
    private IBrowserFile? _importFile;
    private string? _importFileName;
    private CustomerImportResultDto? _importResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        try
        {
            var query = $"?pageNumber={_pageNumber}&pageSize={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_searchText)) query += $"&search={Uri.EscapeDataString(_searchText)}";
            if (!string.IsNullOrWhiteSpace(_searchStatus)) query += $"&status={Uri.EscapeDataString(_searchStatus)}";

            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, "api/v1/customers" + query);
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to load customers: {ExtractErrorMessage(body)}", Severity.Error);
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<PagedResult<CustomerDto>>();
            if (result is not null)
            {
                _customers = result.Items.ToList();
                _totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private int GetPageCount() => (int)Math.Ceiling((double)_totalCount / _pageSize);

    private async Task OnPageChanged(int page)
    {
        _pageNumber = page;
        await LoadCustomers();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _pageNumber = 1;
            await LoadCustomers();
        }
    }

    private void OpenCreateDialog()
    {
        _isEdit = false;
        _model = new CustomerFormModel();
        _nameLocked = false;
        _emailLocked = false;
        _showDialog = true;
    }

    private void OpenEditDialog(CustomerDto customer)
    {
        _isEdit = true;
        _model = new CustomerFormModel
        {
            Id = customer.Id,
            PhoneNumber = customer.PhoneNumber,
            FullName = customer.FullName,
            Email = customer.Email
        };
        // CR-2026-09-06-11 fill-empty-only (mirrors the API): fields with real values are
        // locked for brands; placeholder rows (name == phone) and empty emails stay editable.
        _nameLocked = !string.IsNullOrWhiteSpace(customer.FullName) && customer.FullName != customer.PhoneNumber;
        _emailLocked = !string.IsNullOrWhiteSpace(customer.Email);
        _showDialog = true;
    }

    private void OpenImportDialog()
    {
        _importFile = null;
        _importFileName = null;
        _importResult = null;
        _showImportDialog = true;
    }

    /// <summary>Opens the read-only voucher history of this customer (brand-scoped, server-side).</summary>
    private async Task OpenVoucherHistory(CustomerDto customer)
    {
        var parameters = new DialogParameters<CustomerVouchersDialog>
        {
            { x => x.CustomerId, customer.Id },
            { x => x.CustomerName, customer.FullName }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CustomerVouchersDialog>(
            $"Voucher History — {customer.FullName}", parameters, options);
        await dialog.Result;
    }

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        _importFile = e.File;
        _importFileName = e.File.Name;
    }

    private async Task UploadImport()
    {
        if (_importFile == null) return;

        try
        {
            using var content = new MultipartFormDataContent();
            using var fileStream = _importFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var streamContent = new StreamContent(fileStream);
            var mediaType = _importFile.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)
                ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                : "text/csv";
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mediaType);
            content.Add(streamContent, "file", _importFile.Name);

            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Post, "api/v1/customers/import") { Content = content };
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                _importResult = await response.Content.ReadFromJsonAsync<CustomerImportResultDto>();
                var succeeded = (_importResult?.Created ?? 0) + (_importResult?.Updated ?? 0);
                var skipped = _importResult?.SkippedCount ?? 0;
                var failed = _importResult?.ErrorCount ?? 0;
                Snackbar.Add($"Import finished: {succeeded} succeeded, {skipped} kept existing values, {failed} error(s).", failed == 0 ? Severity.Success : Severity.Warning);
                await LoadCustomers();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Import failed: {ExtractErrorMessage(body)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadTemplate()
    {
        try
        {
            var bytes = CustomerImportTemplate.BuildXlsx();
            await JS.InvokeVoidAsync("downloadFromBase64",
                "customer-import-template.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not build the template: {ex.Message}", Severity.Error);
        }
    }

    private static string ExtractErrorMessage(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var error) && error.ValueKind == System.Text.Json.JsonValueKind.String)
                return error.GetString() ?? body;
        }
        catch
        {
            // not JSON - show the raw body
        }
        return body;
    }

    private async Task DownloadErrorLog()
    {
        if (_importResult == null || _importResult.Errors.Count == 0) return;
        await DownloadRows("customer-import-errors", "Row,PhoneNumber,FullName,Email,ErrorMessage",
            _importResult.Errors.Select(e => RowCsv(e.Row, e.PhoneNumber, e.FullName, e.Email, e.Message)));
    }

    private async Task DownloadSkippedLog()
    {
        if (_importResult == null || _importResult.Skipped.Count == 0) return;
        await DownloadRows("customer-import-skipped", "Row,PhoneNumber,FullName,Email,Reason",
            _importResult.Skipped.Select(s => RowCsv(s.Row, s.PhoneNumber, s.FullName, s.Email, s.Message)));
    }

    private static string RowCsv(int row, string phone, string name, string? email, string message)
        => string.Join(",", row.ToString(), CsvEscape(phone), CsvEscape(name), CsvEscape(email), CsvEscape(message));

    private async Task DownloadRows(string filePrefix, string header, IEnumerable<string> lines)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(header);
        foreach (var line in lines)
            sb.AppendLine(line);

        // UTF-8 BOM so Excel opens the file with correct encoding
        var bytes = new byte[] { 0xEF, 0xBB, 0xBF }.Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var fileName = $"{filePrefix}-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFromBase64", fileName, "text/csv", Convert.ToBase64String(bytes));
    }

    private static string CsvEscape(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        var quote = "\"";
        return quote + value.Replace(quote, quote + quote) + quote;
    }

    private async Task SaveCustomer()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        try
        {
            if (_isEdit)
            {
                var request = new { _model.FullName, _model.Email };
                var token = await AuthState.GetTokenAsync();
                var httpRequest = new HttpRequestMessage(HttpMethod.Put, $"api/v1/customers/{_model.Id}") { Content = JsonContent.Create(request) };
                if (!string.IsNullOrEmpty(token))
                    httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                var response = await Http.SendAsync(httpRequest);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Customer updated successfully.", Severity.Success);
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Update failed: {error}", Severity.Error);
                    return;
                }
            }
            else
            {
                var request = new { _model.PhoneNumber, _model.FullName, _model.Email };
                var token = await AuthState.GetTokenAsync();
                var httpRequest = new HttpRequestMessage(HttpMethod.Post, "api/v1/customers") { Content = JsonContent.Create(request) };
                if (!string.IsNullOrEmpty(token))
                    httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                var response = await Http.SendAsync(httpRequest);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Customer created successfully.", Severity.Success);
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Create failed: {error}", Severity.Error);
                    return;
                }
            }

            _showDialog = false;
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    // Per-brand block (customer-action-matrix S1): stops this customer from receiving
    // this brand's promotions / buying this brand's plans / being gifted this brand's
    // vouchers. Platform-level blacklisting is Admin-only (API).
    private async Task BlockCustomer(CustomerDto customer)
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/v1/customers/{customer.Id}/block");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer blocked for your brand.", Severity.Success);
                await LoadCustomers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Block failed: {ExtractErrorMessage(error)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task UnblockCustomer(CustomerDto customer)
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/v1/customers/{customer.Id}/unblock");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer unblocked.", Severity.Success);
                await LoadCustomers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Unblock failed: {ExtractErrorMessage(error)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Blacklisted" => Color.Error,
        _ => Color.Default
    };

    public class CustomerDto
    {
        public Guid Id { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public DateTime? UpdatedAt { get; set; }
        public bool? IsBrandBlocked { get; set; }
    }

    public class PagedResult<T>
    {
        public IReadOnlyList<T> Items { get; set; } = Array.Empty<T>();
        public int TotalCount { get; set; }
        public int PageNumber { get; set; }
        public int PageSize { get; set; }
    }

    public class CustomerFormModel
    {
        public Guid Id { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
    }

    public class CustomerImportResultDto
    {
        public int Created { get; set; }
        public int Updated { get; set; }
        public int Unchanged { get; set; }
        public int SkippedCount { get; set; }
        public List<CustomerImportSkipItem> Skipped { get; set; } = new();
        public int ErrorCount { get; set; }
        public List<CustomerImportErrorItem> Errors { get; set; } = new();
    }

    public class CustomerImportSkipItem
    {
        public int Row { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    public class CustomerImportErrorItem
    {
        public int Row { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}

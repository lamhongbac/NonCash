@page "/member-login"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Customer Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">NonCash</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">Customer Sign In</MudText>

        <MudForm @ref="_form">
            <MudTextField @bind-Value="_loginId" Label="Phone number or email" Required="true" RequiredError="Enter your phone number or email" Variant="Variant.Outlined" FullWidth="true" Class="mb-2"
                          HelperText="NonCash never asks you for a username." Placeholder="0913660575 or you@example.com" />
            <MudTextField @bind-Value="_password" Label="Password" Required="true" RequiredError="Password is required" Variant="Variant.Outlined" FullWidth="true" InputType="InputType.Password" Class="mb-1" />
            <MudText Typo="Typo.body2" Align="Align.End" Class="mb-4">
                <MudLink Href="/member/forgot-password" Underline="Underline.Always">Forgot password?</MudLink>
            </MudText>
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="HandleLogin" Disabled="_loading">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Sign In
        </MudButton>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            Are you an admin or brand staff? <MudLink Href="/login">Admin / Brand Staff Login</MudLink>
        </MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
            Don't have an account? <MudLink Href="/member-register">Create a customer account</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _loginId = "";
    private string _password = "";
    private bool _loading = false;
    private string? _errorMessage = null;

    private async Task HandleLogin()
    {
        _errorMessage = null;

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        _loading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/member/login", new { Identifier = _loginId, Password = _password });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                if (result != null)
                {
                    await AuthState.LoginAsync(
                        result.Token,
                        result.User?.FullName ?? _loginId,
                        result.User?.Role ?? "Member",
                        result.User?.BrandId,
                        result.User?.UserId ?? Guid.Empty,
                        result.User?.CustomerId,
                        result.ExpiresAt);

                    await AuthState.StartIdleTimerAsync();
                    Snackbar.Add($"Welcome, {AuthState.FullName}!", Severity.Success);
                    Navigation.NavigateTo("/store", forceLoad: true);
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _errorMessage = error?.error ?? "Invalid phone number/email or password. Please try again.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _errorMessage = "Your account is locked. Contact the brand that sent you the voucher and ask them to unlock it.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                _errorMessage = "Too many sign-in attempts. Wait one minute and try again, or use Forgot password to get a sign-in link.";
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _errorMessage = error?.error ?? "An unexpected error occurred. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Network error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginResult
    {
        public string Token { get; set; } = "";
        public DateTime ExpiresAt { get; set; }
        public UserInfo? User { get; set; }
    }

    private class UserInfo
    {
        public Guid UserId { get; set; }
        public string FullName { get; set; } = "";
        public string Role { get; set; } = "";
        public Guid? BrandId { get; set; }
        public Guid? CustomerId { get; set; }
    }

    private class ErrorResponse
    {
        public string? error { get; set; }
    }
}

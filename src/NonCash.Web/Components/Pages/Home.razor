@page "/"
@inject NonCash.Web.Services.ClientAuthService AuthState
@implements IDisposable

<PageTitle>NonCash Dashboard</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Welcome to NonCash</MudText>

@if (AuthState.IsLoggedIn)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        You are logged in as <strong>@AuthState.FullName</strong> <MudChip T="string" Size="Size.Small" Color="Color.Primary">@AuthState.Role</MudChip>
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        You are not logged in. Please sign in to access your account.
    </MudAlert>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthState.OnAuthStateChanged += OnAuthStateChanged;
        await AuthState.InitializeAsync();
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.OnAuthStateChanged -= OnAuthStateChanged;
    }
}

<MudText Typo="Typo.body1" Class="mb-6">
    NonCash is a SaaS voucher platform enabling brands to create, distribute, and redeem digital vouchers securely.
</MudText>

@* Registration/login entry cards are only relevant to anonymous visitors. *@
@if (!AuthState.IsLoggedIn)
{
<MudGrid>
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.AppRegistration" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2">Business Registration</MudText>
                <MudText Typo="Typo.body2">Register your company to start creating vouchers.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Get Started</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2">Brand Staff Login</MudText>
                <MudText Typo="Typo.body2">For brand staff (managers, planners, approvers) — manage your brand, outlets, and vouchers.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true">Sign In</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2">Customer Login</MudText>
                <MudText Typo="Typo.body2">For customers — buy, manage, and redeem your vouchers.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/member-login" Variant="Variant.Filled" Color="Color.Success" FullWidth="true">Sign In</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2">Admin Portal</MudText>
                <MudText Typo="Typo.body2">For platform administrators — manage brands, users, and platform settings.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/admin/brands" Variant="Variant.Filled" Color="Color.Info" FullWidth="true">Admin Panel</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
}

<MudPaper Class="pa-4 mt-6">
    <MudText Typo="Typo.h5" GutterBottom="true">Platform Status</MudText>
    <MudList T="string">
        <MudListItem Text="Core services: Online" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" />
        <MudListItem Text="Database: PostgreSQL Connected" Icon="@Icons.Material.Filled.Storage" IconColor="Color.Info" />
        <MudListItem Text="Authentication: JWT Enabled" Icon="@Icons.Material.Filled.Security" IconColor="Color.Success" />
    </MudList>
</MudPaper>

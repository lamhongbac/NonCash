@page "/admin/credits"
@attribute [StreamRendering]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Credit Management</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Credit Management</MudText>

@* ── Brand selector / balance ─────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="5">
            <MudSelect T="BrandLookupDto?" @bind-Value="_selectedBrand"
                       Label="Select Brand"
                       Variant="Variant.Outlined"
                       ToStringFunc="@((BrandLookupDto? b) => b == null ? "" : $"{b.Name}")"
                       AnchorOrigin="Origin.BottomLeft">
                @foreach (var b in _brands)
                {
                    <MudSelectItem Value="@((BrandLookupDto?)b)">@b.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadBrandData" Disabled="_loading">
                View Credits
            </MudButton>
        </MudItem>
        @if (_balance != null)
        {
            <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                <MudChip T="string"
                         Color="@(_balance.Value > 50 ? Color.Success : _balance.Value > 0 ? Color.Warning : Color.Error)"
                         Icon="@Icons.Material.Filled.Toll"
                         Size="Size.Large">
                    Balance: @_balance.Value credits
                </MudChip>
            </MudItem>
        }
    </MudGrid>
    @if (_pricing != null)
    {
        <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Policy">
                Policy: @_pricing.Name
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                @_pricing.PricePerCreditVnd.ToString("N0") ₫ / credit
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                Expiry: @(_pricing.CreditExpiryMonths.HasValue ? $"{_pricing.CreditExpiryMonths} months" : "never")
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                Approval threshold: @(_pricing.AdjustmentApprovalThreshold?.ToString() ?? "always")
            </MudChip>
        </MudStack>
    }
</MudPaper>

@* ── Purchase top-up (bank money-in verified first) ──────────── *@
@if (_selectedBrand != null)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Record Credit Purchase — @_selectedBrand.Name</MudText>
        <MudText Typo="Typo.caption" Class="mb-2">
            Verify the bank money-in first. Price and expiry are snapshotted from the brand's pricing policy.
            For grants, compensations and corrections use the
            <MudLink Href="/admin/credit-adjustments">Adjustments</MudLink> workflow.
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="2">
                <MudNumericField @bind-Value="_topupAmount"
                                 Label="Credits"
                                 Variant="Variant.Outlined"
                                 Min="1" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_topupReference"
                              Label="Bank reference"
                              Variant="Variant.Outlined"
                              MaxLength="200" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_topupEvidenceUrl"
                              Label="Bank slip image URL"
                              Variant="Variant.Outlined"
                              MaxLength="500" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.AddCard"
                           OnClick="ExecutePurchase" Disabled="_submitting" FullWidth="true">
                    @if (_submitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Confirm Purchase
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (_pricing != null && _topupAmount > 0)
        {
            <MudText Typo="Typo.body2" Class="mt-1">
                Total: <b>@((_topupAmount * _pricing.PricePerCreditVnd).ToString("N0")) ₫</b>
                (@_topupAmount × @_pricing.PricePerCreditVnd.ToString("N0") ₫)
            </MudText>
        }
    </MudPaper>
}

@* ── Batches / consumptions ──────────────────────────────────── *@
@if (_selectedBrand != null)
{
    <MudPaper Class="pa-4 mb-4">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pt-4">
            <MudTabPanel Text="Batches">
                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="3">
                        <MudSelect @bind-Value="_filterType" Label="Filter by type" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var t in BatchTypes)
                            {
                                <MudSelectItem Value="@((string?)t)">@t</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="9" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadBatches">Refresh</MudButton>
                    </MudItem>
                </MudGrid>

                @if (_loadingBatches)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_batches != null)
                {
                    <MudTable Items="_batches" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh Style="text-align:right">Original</MudTh>
                            <MudTh Style="text-align:right">Remaining</MudTh>
                            <MudTh Style="text-align:right">Paid (₫)</MudTh>
                            <MudTh>Expires</MudTh>
                            <MudTh>Reference</MudTh>
                            <MudTh>Evidence</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Color="@GetBatchColor(context.BatchType)" Size="Size.Small">@context.BatchType</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Original" Style="text-align:right;font-weight:bold">
                                <span style="@(context.OriginalAmount >= 0 ? "color:green" : "color:red")">@(context.OriginalAmount > 0 ? $"+{context.OriginalAmount}" : context.OriginalAmount.ToString())</span>
                            </MudTd>
                            <MudTd DataLabel="Remaining" Style="text-align:right">@context.RemainingAmount</MudTd>
                            <MudTd DataLabel="Paid" Style="text-align:right">@(context.TotalPaidVnd > 0 ? context.TotalPaidVnd.ToString("N0") : "—")</MudTd>
                            <MudTd DataLabel="Expires">
                                @if (context.ExpiresAt.HasValue)
                                {
                                    <span style="@(context.ExpiresAt.Value < DateTime.UtcNow ? "color:red" : "")">@context.ExpiresAt.Value.ToString("yyyy-MM-dd")</span>
                                }
                                else
                                {
                                    <span>never</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Reference">@(context.Reference ?? "—")</MudTd>
                            <MudTd DataLabel="Evidence">
                                @if (!string.IsNullOrEmpty(context.EvidenceImageUrl))
                                {
                                    <MudLink Href="@context.EvidenceImageUrl" Target="_blank">view</MudLink>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="8">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption">@_batchTotal batches total</MudText>
                                    <MudStack Row="true" Spacing="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="_batchPage <= 1" OnClick="PrevBatchPage" />
                                        <MudText Typo="Typo.body2" Class="align-self-center">Page @_batchPage</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="_batchPage * _pageSize >= _batchTotal" OnClick="NextBatchPage" />
                                    </MudStack>
                                </MudStack>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="Consumptions">
                @if (_loadingConsumptions)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_consumptions != null)
                {
                    <MudTable Items="_consumptions" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Voucher</MudTh>
                            <MudTh>Batch</MudTh>
                            <MudTh>Reference</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
                            <MudTd DataLabel="Voucher">@(context.VoucherDetailId.ToString()[..8])…</MudTd>
                            <MudTd DataLabel="Batch">@(context.BatchId.ToString()[..8])…</MudTd>
                            <MudTd DataLabel="Reference">@(context.Reference ?? "—")</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="4">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption">@_consumptionTotal consumptions total</MudText>
                                    <MudStack Row="true" Spacing="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="_consumptionPage <= 1" OnClick="PrevConsumptionPage" />
                                        <MudText Typo="Typo.body2" Class="align-self-center">Page @_consumptionPage</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="_consumptionPage * _pageSize >= _consumptionTotal" OnClick="NextConsumptionPage" />
                                    </MudStack>
                                </MudStack>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadConsumptions">Load consumptions</MudButton>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    // ── State ────────────────────────────────────────────────────
    private bool _loading = false;
    private bool _loadingBatches = false;
    private bool _loadingConsumptions = false;
    private bool _submitting = false;

    private List<BrandLookupDto> _brands = new();
    private BrandLookupDto? _selectedBrand;
    private int? _balance;
    private ResolvedPolicyDto? _pricing;

    private static readonly string[] BatchTypes =
        { "Purchase", "WelcomeGrant", "Grant", "Compensation", "Correction", "Clawback", "Reinstatement" };

    // Purchase form
    private int _topupAmount = 100;
    private string? _topupReference;
    private string? _topupEvidenceUrl;

    // Batches
    private List<CreditBatchDto>? _batches;
    private string? _filterType;
    private int _batchPage = 1;
    private int _batchTotal = 0;
    private const int _pageSize = 20;

    // Consumptions
    private List<CreditConsumptionDto>? _consumptions;
    private int _consumptionPage = 1;
    private int _consumptionTotal = 0;

    // ── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (AuthState.Role != "Admin")
        {
            Snackbar.Add("Access denied — Admin only.", Severity.Error);
            return;
        }
        await LoadBrandsAsync();
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string url, object? payload = null)
    {
        var req = new HttpRequestMessage(method, url);
        if (payload != null)
            req.Content = JsonContent.Create(payload);
        var token = await AuthState.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return await Http.SendAsync(req);
    }

    private async Task LoadBrandsAsync()
    {
        try
        {
            var resp = await SendAsync(HttpMethod.Get, "api/v1/brands?pageSize=200");
            if (resp.IsSuccessStatusCode)
            {
                var paged = await resp.Content.ReadFromJsonAsync<PagedResult<BrandLookupDto>>();
                _brands = paged?.Items ?? new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load brands: {ex.Message}", Severity.Error);
        }
    }

    // ── Balance + pricing + batches ──────────────────────────────
    private async Task LoadBrandData()
    {
        if (_selectedBrand == null) return;
        _loading = true;
        _balance = null;
        _pricing = null;
        _batches = null;
        _consumptions = null;
        try
        {
            var resp = await SendAsync(HttpMethod.Get, $"api/v1/credits/balance?brandId={_selectedBrand.Id}");
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreditBalanceDto>();
                _balance = result?.Balance;
            }
            else
            {
                Snackbar.Add("Failed to load balance.", Severity.Error);
            }

            var pricingResp = await SendAsync(HttpMethod.Get, $"api/v1/credits/pricing?brandId={_selectedBrand.Id}");
            if (pricingResp.IsSuccessStatusCode)
                _pricing = await pricingResp.Content.ReadFromJsonAsync<ResolvedPolicyDto>();

            _batchPage = 1;
            await LoadBatches();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    // ── Purchase ─────────────────────────────────────────────────
    private async Task ExecutePurchase()
    {
        if (_selectedBrand == null) return;
        if (_topupAmount < 1)
        {
            Snackbar.Add("Amount must be positive.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var payload = new
            {
                BrandId = _selectedBrand.Id,
                Amount = _topupAmount,
                Reference = _topupReference,
                EvidenceImageUrl = _topupEvidenceUrl
            };
            var resp = await SendAsync(HttpMethod.Post, "api/v1/credits/topup", payload);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Purchase of {_topupAmount} credits recorded for {_selectedBrand.Name}.", Severity.Success);
                _topupAmount = 100;
                _topupReference = null;
                _topupEvidenceUrl = null;
                await LoadBrandData();
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Purchase failed: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally { _submitting = false; }
    }

    // ── Batches ──────────────────────────────────────────────────
    private async Task LoadBatches()
    {
        if (_selectedBrand == null) return;
        _loadingBatches = true;
        try
        {
            var url = $"api/v1/credits/batches?brandId={_selectedBrand.Id}&page={_batchPage}&pageSize={_pageSize}";
            if (!string.IsNullOrEmpty(_filterType)) url += $"&type={_filterType}";

            var resp = await SendAsync(HttpMethod.Get, url);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreditBatchListDto>();
                _batches = result?.Batches ?? new();
                _batchTotal = result?.TotalCount ?? 0;
            }
            else
            {
                Snackbar.Add("Failed to load batches.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading batches: {ex.Message}", Severity.Error);
        }
        finally { _loadingBatches = false; }
    }

    private async Task PrevBatchPage() { _batchPage--; await LoadBatches(); }
    private async Task NextBatchPage() { _batchPage++; await LoadBatches(); }

    // ── Consumptions ─────────────────────────────────────────────
    private async Task LoadConsumptions()
    {
        if (_selectedBrand == null) return;
        _loadingConsumptions = true;
        try
        {
            var url = $"api/v1/credits/consumptions?brandId={_selectedBrand.Id}&page={_consumptionPage}&pageSize={_pageSize}";
            var resp = await SendAsync(HttpMethod.Get, url);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreditConsumptionListDto>();
                _consumptions = result?.Consumptions ?? new();
                _consumptionTotal = result?.TotalCount ?? 0;
            }
            else
            {
                Snackbar.Add("Failed to load consumptions.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading consumptions: {ex.Message}", Severity.Error);
        }
        finally { _loadingConsumptions = false; }
    }

    private async Task PrevConsumptionPage() { _consumptionPage--; await LoadConsumptions(); }
    private async Task NextConsumptionPage() { _consumptionPage++; await LoadConsumptions(); }

    // ── Helpers ──────────────────────────────────────────────────
    private static Color GetBatchColor(string type) => type switch
    {
        "Purchase"      => Color.Primary,
        "WelcomeGrant"  => Color.Info,
        "Grant"         => Color.Success,
        "Compensation"  => Color.Success,
        "Correction"    => Color.Warning,
        "Clawback"      => Color.Error,
        "Reinstatement" => Color.Warning,
        _               => Color.Default
    };

    // ── Local DTOs ───────────────────────────────────────────────
    private class BrandLookupDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }

    private class CreditBalanceDto
    {
        public Guid BrandId { get; set; }
        public int Balance { get; set; }
    }

    private class ResolvedPolicyDto
    {
        public Guid? PolicyId { get; set; }
        public string Name { get; set; } = "";
        public string? Scope { get; set; }
        public decimal PricePerCreditVnd { get; set; }
        public int? CreditExpiryMonths { get; set; }
        public int WelcomeCredits { get; set; }
        public int? WelcomeCreditExpiryMonths { get; set; }
        public int? LowBalanceWarningPct { get; set; }
        public int? ExpiryWarningDays { get; set; }
        public int? AdjustmentApprovalThreshold { get; set; }
    }

    private class CreditBatchDto
    {
        public Guid Id { get; set; }
        public Guid BrandId { get; set; }
        public string BatchType { get; set; } = "";
        public int OriginalAmount { get; set; }
        public int RemainingAmount { get; set; }
        public decimal PricePerCreditVnd { get; set; }
        public decimal TotalPaidVnd { get; set; }
        public DateTime? ExpiresAt { get; set; }
        public string? EvidenceImageUrl { get; set; }
        public string? Reference { get; set; }
        public Guid? AdjustmentRequestId { get; set; }
        public Guid? CreatedBy { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private class CreditBatchListDto
    {
        public List<CreditBatchDto> Batches { get; set; } = new();
        public int TotalCount { get; set; }
    }

    private class CreditConsumptionDto
    {
        public Guid Id { get; set; }
        public Guid BatchId { get; set; }
        public Guid VoucherDetailId { get; set; }
        public string? Reference { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private class CreditConsumptionListDto
    {
        public List<CreditConsumptionDto> Consumptions { get; set; } = new();
        public int TotalCount { get; set; }
    }

    private class PagedResult<T>
    {
        public List<T> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }
}

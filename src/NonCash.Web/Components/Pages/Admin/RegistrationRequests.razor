@page "/admin/registration-requests"
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Registration Requests</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Business Registration Requests</MudText>
<MudText Typo="Typo.body1" Class="mb-4">Send contracts, collect signed hardcopies, and approve or reject business registrations.</MudText>

<MudStack Row="true" Spacing="2" Class="mb-4">
    <MudButton Variant="@(_filter == "pending-contract" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => FilterChanged("pending-contract"))">Pending Contract</MudButton>
    <MudButton Variant="@(_filter == "pending-review" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => FilterChanged("pending-review"))">Pending Review</MudButton>
    <MudButton Variant="@(_filter == "all" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => FilterChanged("all"))">All Requests</MudButton>
</MudStack>

@if (!_hasActiveSubscriptionPolicy)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        No active subscription fee policy exists for today. Please create one in <strong>Subscription Fee Policies</strong> before sending contracts.
    </MudAlert>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (!_requests.Any())
{
    <MudAlert Severity="Severity.Info">No registration requests found.</MudAlert>
}
else
{
    foreach (var req in _requests)
    {
        <MudCard Class="mb-4" Elevation="2">
            <MudCardContent>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <div>
                        <MudText Typo="Typo.h6">@req.BusinessName</MudText>
                        <MudText Typo="Typo.body2">Tax Code: @req.TaxCode | Email: @req.ContactEmail | Phone: @req.PhoneNumber</MudText>
                        <MudText Typo="Typo.body2">Address: @req.Address</MudText>
                        <MudText Typo="Typo.body2">Representative: @req.RepresentativeName</MudText>
                        @if (req.HasFirstBrandDeclaration)
                        {
                            <MudText Typo="Typo.body2">First Brand: @req.FirstBrandName | Manager: @req.ManagerUsername</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Warning">No first brand declared — admin must create brand after approval.</MudText>
                        }
                        <MudText Typo="Typo.body2">Submitted: @req.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                        @if (!string.IsNullOrEmpty(req.WelcomePolicyTemplateName))
                        {
                            <MudText Typo="Typo.body2">Policy: @req.WelcomePolicyTemplateName</MudText>
                        }
                    </div>
                    <div>
                        @if (req.Status == "Submitted")
                        {
                            @if (req.ContractStatus == "None")
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-2">Contract Not Sent</MudAlert>
                                <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => _ = OpenSendContractDialog(req))">
                                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" Class="mr-1" /> Send Contract
                                </MudButton>
                            }
                            else if (req.ContractStatus == "Sent")
                            {
                                <MudAlert Severity="Severity.Info" Class="mb-2">Contract Sent @(!string.IsNullOrEmpty(req.ContractSentAt) ? $"at {req.ContractSentAt}" : "") — awaiting business confirmation</MudAlert>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => PrintContractAsync(req))">
                                        <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Class="mr-1" /> Print
                                    </MudButton>
                                    <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => OpenUploadContractDialog(req))">
                                        <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" Class="mr-1" /> Upload Signed
                                    </MudButton>
                                </MudStack>
                            }
                            else if (req.ContractStatus == "Confirmed")
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-2">Contract Confirmed by Business</MudAlert>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => OpenApproveDialog(req))">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" /> Approve
                                    </MudButton>
                                    <MudButton Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => OpenRejectDialog(req))">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="mr-1" /> Reject
                                    </MudButton>
                                </MudStack>
                            }
                            else if (req.ContractStatus == "Signed")
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-2">Contract Signed (Uploaded)</MudAlert>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => OpenApproveDialog(req))">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" /> Approve
                                    </MudButton>
                                    <MudButton Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => OpenRejectDialog(req))">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="mr-1" /> Reject
                                    </MudButton>
                                </MudStack>
                            }
                        }
                        else if (req.Status == "Approved")
                        {
                            <MudAlert Severity="Severity.Success">Approved by @req.ReviewedByName</MudAlert>
                        }
                        else if (req.Status == "Rejected")
                        {
                            <MudAlert Severity="Severity.Error">Rejected by @req.ReviewedByName</MudAlert>
                        }
                        @if (!string.IsNullOrEmpty(req.ReviewNotes))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1"><em>Notes: "@req.ReviewNotes"</em></MudText>
                        }
                    </div>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
}

<MudDialog @bind-Visible="_showSendContractDialog" Options="_dialogOptions" TitleClass="mud-theme-primary py-2 px-4">
    <TitleContent>
        <MudText Typo="Typo.h6">Send Contract — @_selectedRequest?.BusinessName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudAlert Severity="Severity.Info" Dense="true">
                Select the welcome-grant policy to attach to the contract. The business can confirm acceptance online, or the admin can upload a signed hardcopy.
            </MudAlert>

            <MudSelect T="Guid?" @bind-Value="_selectedTemplateId" Label="Welcome policy template" Variant="Variant.Outlined"
                       ToStringFunc="@GetTemplateDisplayText">
                <MudSelectItem T="Guid?" Value="(Guid?)null">Platform default</MudSelectItem>
                @foreach (var t in _templates)
                {
                    <MudSelectItem T="Guid?" Value="(Guid?)t.Id">@t.Name (@t.WelcomeCredits credits, @(t.WelcomeCreditExpiryMonths?.ToString() ?? "never") mo)@(t.IsDefault ? " — default" : "")</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.body2" Color="Color.Surface">
                Resolved: <strong>@_resolvedCredits credits</strong>, expires in <strong>@(_resolvedExpiryMonths?.ToString() ?? "never") months</strong>.
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmSendContract" Disabled="_submitting">Send Contract</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showUploadContractDialog" Options="_dialogOptions" TitleClass="mud-theme-primary py-2 px-4">
    <TitleContent>
        <MudText Typo="Typo.h6">Upload Signed Contract — @_selectedRequest?.BusinessName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudAlert Severity="Severity.Info" Dense="true">
                Upload the signed contract as a PDF or image. This is optional if the business has already confirmed online.
            </MudAlert>
            <MudFileUpload T="IBrowserFile" @bind-Value="_signedContractFile" Accept=".pdf,.jpg,.jpeg,.png" />
            @if (_signedContractFile != null)
            {
                <MudText Typo="Typo.body2">Selected: @_signedContractFile.Name (@((_signedContractFile.Size / 1024.0 / 1024.0).ToString("0.##")) MB)</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmUploadSignedContract" Disabled="_submitting || _signedContractFile == null">Upload</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showApproveDialog" Options="_dialogOptions" TitleClass="mud-theme-primary py-2 px-4">
    <TitleContent>
        <MudText Typo="Typo.h6">Approve Registration — @_selectedRequest?.BusinessName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudAlert Severity="Severity.Info" Dense="true">
                The signed contract has been received. Approval will activate the business, grant welcome credits, and send the activation email.
            </MudAlert>
            <MudTextField @bind-Value="_reviewNotes" Label="Review notes (optional)" Variant="Variant.Outlined" Lines="3" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmApprove" Disabled="_submitting">Approve</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showRejectDialog" Options="_dialogOptions" TitleClass="mud-theme-error py-2 px-4">
    <TitleContent>
        <MudText Typo="Typo.h6">Reject Registration — @_selectedRequest?.BusinessName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudAlert Severity="Severity.Warning" Dense="true">
                Please provide a reason; it will be included in the rejection email to the applicant.
            </MudAlert>
            <MudTextField @bind-Value="_reviewNotes" Label="Rejection reason" Variant="Variant.Outlined" Lines="3" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmReject" Disabled="_submitting">Reject</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RegistrationRequestItem> _requests = new();
    private List<WelcomePolicyTemplateItem> _templates = new();
    private bool _loading = true;
    private bool _submitting = false;
    private string _filter = "pending-contract";
    private bool _hasActiveSubscriptionPolicy = false;

    private bool _showSendContractDialog = false;
    private bool _showUploadContractDialog = false;
    private bool _showApproveDialog = false;
    private bool _showRejectDialog = false;
    private RegistrationRequestItem? _selectedRequest;
    private Guid? _selectedTemplateId;
    private string _reviewNotes = "";
    private IBrowserFile? _signedContractFile;

    private int _resolvedCredits => _selectedTemplateId.HasValue
        ? (_templates.FirstOrDefault(t => t.Id == _selectedTemplateId.Value)?.WelcomeCredits ?? _defaultTemplate?.WelcomeCredits ?? 0)
        : (_defaultTemplate?.WelcomeCredits ?? 0);

    private int? _resolvedExpiryMonths => _selectedTemplateId.HasValue
        ? (_templates.FirstOrDefault(t => t.Id == _selectedTemplateId.Value)?.WelcomeCreditExpiryMonths ?? _defaultTemplate?.WelcomeCreditExpiryMonths)
        : _defaultTemplate?.WelcomeCreditExpiryMonths;

    private WelcomePolicyTemplateItem? _defaultTemplate => _templates.FirstOrDefault(t => t.IsDefault);

    private readonly DialogOptions _dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsLoggedIn || !string.Equals(AuthState.Role, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            AuthState.NavigateToLogin();
            return;
        }

        await LoadTemplates();
        await LoadRequests();
        await CheckActiveSubscriptionPolicyAsync();
    }

    private async Task CheckActiveSubscriptionPolicyAsync()
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, "api/v1/subscription-fee-policies/effective");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            _hasActiveSubscriptionPolicy = response.IsSuccessStatusCode;
        }
        catch
        {
            _hasActiveSubscriptionPolicy = false;
        }
    }

    private async Task FilterChanged(string value)
    {
        _filter = value;
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        _loading = true;
        try
        {
            var token = await AuthState.GetTokenAsync();
            var endpoint = _filter switch
            {
                "pending-contract" => "api/v1/admin/registration-requests/pending-contract",
                "pending-review" => "api/v1/admin/registration-requests/pending-review",
                _ => "api/v1/admin/registration-requests"
            };
            var request = new HttpRequestMessage(HttpMethod.Get, endpoint);
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<RegistrationRequestItem>>();
                _requests = result ?? new();
            }
            else
            {
                Snackbar.Add($"Failed to load requests: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTemplates()
    {
        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, "api/v1/welcome-policy-templates");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<WelcomePolicyTemplateItem>>();
                _templates = result ?? new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load policy templates: {ex.Message}", Severity.Warning);
        }
    }

    private async Task PrintContractAsync(RegistrationRequestItem item)
    {
        // Open the blank window synchronously while still inside the user-initiated click event,
        // so the browser allows the popup. The HTML is written after the async API call.
        var opened = await JSRuntime.InvokeAsync<bool>("noncashContractPrint.openWindow");
        if (!opened) return;

        try
        {
            var token = await AuthState.GetTokenAsync();
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/v1/admin/registration-requests/{item.RequestId}/contract");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var html = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("noncashContractPrint.writeHtml", html);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Snackbar.Add("Session expired. Please log in again.", Severity.Warning);
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                var message = string.IsNullOrWhiteSpace(errorBody)
                    ? $"Contract request failed ({(int)response.StatusCode})."
                    : $"Contract request failed ({(int)response.StatusCode}): {errorBody}";
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load contract: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenSendContractDialog(RegistrationRequestItem item)
    {
        await CheckActiveSubscriptionPolicyAsync();
        if (!_hasActiveSubscriptionPolicy)
        {
            Snackbar.Add("No active subscription fee policy found. Please create one in Subscription Fee Policies before sending the contract.", Severity.Warning);
            return;
        }

        _selectedRequest = item;
        _selectedTemplateId = _defaultTemplate?.Id;
        _reviewNotes = "";
        _showSendContractDialog = true;
    }

    private void OpenUploadContractDialog(RegistrationRequestItem item)
    {
        _selectedRequest = item;
        _signedContractFile = null;
        _showUploadContractDialog = true;
    }

    private void OpenApproveDialog(RegistrationRequestItem item)
    {
        _selectedRequest = item;
        _reviewNotes = "";
        _showApproveDialog = true;
    }

    private void OpenRejectDialog(RegistrationRequestItem item)
    {
        _selectedRequest = item;
        _reviewNotes = "";
        _showRejectDialog = true;
    }

    private void CloseDialog()
    {
        _showSendContractDialog = false;
        _showUploadContractDialog = false;
        _showApproveDialog = false;
        _showRejectDialog = false;
        _selectedRequest = null;
        _selectedTemplateId = null;
        _reviewNotes = "";
        _signedContractFile = null;
    }

    private async Task ConfirmSendContract()
    {
        if (_selectedRequest == null) return;
        if (!_selectedTemplateId.HasValue)
        {
            Snackbar.Add("Please select a welcome policy template.", Severity.Warning);
            return;
        }

        _submitting = true;
        var token = await AuthState.GetTokenAsync();

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post,
                $"api/v1/admin/registration-requests/{_selectedRequest.RequestId}/send-contract");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            request.Content = JsonContent.Create(new { WelcomePolicyTemplateId = _selectedTemplateId.Value });
            request.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Contract sent successfully.", Severity.Success);
                CloseDialog();
                await LoadRequests();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(error?.error ?? "Failed to send contract.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ConfirmUploadSignedContract()
    {
        if (_selectedRequest == null) return;
        if (_signedContractFile == null)
        {
            Snackbar.Add("Please select a signed contract file.", Severity.Warning);
            return;
        }

        _submitting = true;
        var token = await AuthState.GetTokenAsync();

        try
        {
            // Step 1: upload the file to the document storage endpoint.
            using var content = new MultipartFormDataContent();
            var fileStream = _signedContractFile.OpenReadStream(maxAllowedSize: 12 * 1024 * 1024);
            var fileContent = new StreamContent(fileStream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_signedContractFile.ContentType);
            content.Add(fileContent, "file", _signedContractFile.Name);
            content.Add(new StringContent("signed_contracts"), "entity");
            content.Add(new StringContent(_selectedRequest.RequestId.ToString()), "uniqueCode");

            var uploadRequest = new HttpRequestMessage(HttpMethod.Post, "api/v1/upload/document") { Content = content };
            if (!string.IsNullOrEmpty(token))
                uploadRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var uploadResponse = await Http.SendAsync(uploadRequest);
            if (!uploadResponse.IsSuccessStatusCode)
            {
                var uploadError = await uploadResponse.Content.ReadFromJsonAsync<UploadErrorResponse>();
                Snackbar.Add(uploadError?.error ?? "Failed to upload the file.", Severity.Error);
                return;
            }

            var uploadResult = await uploadResponse.Content.ReadFromJsonAsync<UploadSuccessResponse>();
            var fileUrl = uploadResult?.url;
            if (string.IsNullOrWhiteSpace(fileUrl))
            {
                Snackbar.Add("Upload succeeded but no file URL was returned.", Severity.Error);
                return;
            }

            // Step 2: attach the stored URL to the registration request.
            var request = new HttpRequestMessage(HttpMethod.Post,
                $"api/v1/admin/registration-requests/{_selectedRequest.RequestId}/upload-signed-contract");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            request.Content = JsonContent.Create(new { ContractFileUrl = fileUrl });
            request.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Signed contract uploaded successfully.", Severity.Success);
                CloseDialog();
                await LoadRequests();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(error?.error ?? "Failed to upload signed contract.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ConfirmApprove()
    {
        if (_selectedRequest == null) return;
        await SubmitReview(_selectedRequest.RequestId, true, _reviewNotes);
        CloseDialog();
    }

    private async Task ConfirmReject()
    {
        if (_selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(_reviewNotes))
        {
            Snackbar.Add("Please provide a rejection reason.", Severity.Warning);
            return;
        }
        await SubmitReview(_selectedRequest.RequestId, false, _reviewNotes);
        CloseDialog();
    }

    private async Task SubmitReview(Guid requestId, bool approve, string notes)
    {
        _submitting = true;
        var token = await AuthState.GetTokenAsync();

        try
        {
            var action = approve ? "approve" : "reject";
            var request = new HttpRequestMessage(HttpMethod.Post,
                $"api/v1/admin/registration-requests/{requestId}/{action}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            request.Content = JsonContent.Create(new { ReviewNotes = notes });
            request.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    approve ? "Approved successfully." : "Rejected.",
                    approve ? Severity.Success : Severity.Warning);
                await LoadRequests();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(error?.error ?? "Action failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private string GetTemplateDisplayText(Guid? id)
    {
        if (id == null) return "Platform default";
        var t = _templates.FirstOrDefault(x => x.Id == id);
        return t == null ? id.ToString()! : $"{t.Name} ({t.WelcomeCredits} credits)";
    }

    public class RegistrationRequestItem
    {
        public Guid RequestId { get; set; }
        public string BusinessName { get; set; } = "";
        public string TaxCode { get; set; } = "";
        public string? ContactEmail { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Address { get; set; }
        public string RepresentativeName { get; set; } = "";
        public string? FirstBrandName { get; set; }
        public string? ManagerUsername { get; set; }
        public bool HasFirstBrandDeclaration { get; set; }
        public string Status { get; set; } = "";
        public string ContractStatus { get; set; } = "";
        public string? ContractSentAt { get; set; }
        public string? ContractFileUrl { get; set; }
        public Guid? WelcomePolicyTemplateId { get; set; }
        public string? WelcomePolicyTemplateName { get; set; }
        public DateTime SubmittedAt { get; set; }
        public DateTime? ReviewedAt { get; set; }
        public string? ReviewNotes { get; set; }
        public string? ReviewedByName { get; set; }
    }

    private class WelcomePolicyTemplateItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public int WelcomeCredits { get; set; }
        public int? WelcomeCreditExpiryMonths { get; set; }
        public bool IsActive { get; set; }
        public bool IsDefault { get; set; }
    }

    private class ErrorResponse
    {
        public string? error { get; set; }
    }

    private class UploadSuccessResponse
    {
        public bool success { get; set; }
        public string? url { get; set; }
    }

    private class UploadErrorResponse
    {
        public bool success { get; set; }
        public string? error { get; set; }
    }
}

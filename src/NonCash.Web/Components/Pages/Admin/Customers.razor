@page "/admin/customers"
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Customer Oversight</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Customer Oversight</MudText>
<MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
    Customers are shared platform-wide across all brands. Admin edits here overwrite the global record —
    every change is written to the audit log (who / when / old → new), because email is the voucher delivery channel.
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_searchText" Label="Search" Placeholder="Name, email or phone"
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" OnKeyDown="OnSearchKeyDown" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_searchStatus" Label="Status" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@((string?)"Active")">Active</MudSelectItem>
                <MudSelectItem Value="@((string?)"Blacklisted")">Blacklisted</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadCustomers">Search</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_customers is not null)
{
    <MudTable Items="_customers" Hover="true" Breakpoint="Breakpoint.Sm">
        <NoRecordsContent>
            <MudText Class="pa-4" Align="Align.Center">No customers found.</MudText>
        </NoRecordsContent>
        <HeaderContent>
            <MudTh>Phone</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Phone">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Name">@context.FullName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => OpenEditDialog(context)" title="Edit (audited)" />
                <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Info" OnClick="() => OpenAuditDialog(context)" title="Audit history" />
                @if (context.Status == "Blacklisted")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" OnClick="() => UnblacklistCustomer(context)" title="Unblacklist" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Error" OnClick="() => BlacklistCustomer(context)" title="Blacklist (platform-wide)" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_totalCount > 0)
    {
        <MudPagination Count="GetPageCount()" Selected="_pageNumber" SelectedChanged="OnPageChanged" Class="mt-4" />
    }
}

<MudDialog @bind-Visible="_showDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Customer (global record)</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            This record is shared by all brands. Every change is recorded in the audit log.
        </MudAlert>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.PhoneNumber" Label="Phone Number" Disabled="true" />
            <MudTextField @bind-Value="_model.FullName" Label="Full Name" Required="true" RequiredError="Name is required" />
            <MudTextField @bind-Value="_model.Email" Label="Email" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDialog = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveCustomer">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showAuditDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Audit History — @_auditCustomerName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_auditLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_audits is not null)
        {
            if (_audits.Count == 0)
            {
                <MudText Typo="Typo.body2">No admin edits recorded for this customer.</MudText>
            }
            else
            {
                <MudTable Items="_audits" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>When</MudTh>
                        <MudTh>Field</MudTh>
                        <MudTh>Old</MudTh>
                        <MudTh>New</MudTh>
                        <MudTh>Changed By</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="When">@context.ChangedAt.ToLocalTime().ToString("g")</MudTd>
                        <MudTd DataLabel="Field">@context.Field</MudTd>
                        <MudTd DataLabel="Old">@(context.OldValue ?? "—")</MudTd>
                        <MudTd DataLabel="New">@(context.NewValue ?? "—")</MudTd>
                        <MudTd DataLabel="Changed By">@(context.ChangedByUserId?.ToString()[..8] ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showAuditDialog = false">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = false;
    private List<CustomerDto>? _customers;
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalCount = 0;
    private string? _searchText;
    private string? _searchStatus;

    private bool _showDialog = false;
    private MudForm? _form;
    private CustomerFormModel _model = new();
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true };

    private bool _showAuditDialog = false;
    private bool _auditLoading = false;
    private string _auditCustomerName = string.Empty;
    private List<CustomerAuditItem>? _audits;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        try
        {
            var query = $"?pageNumber={_pageNumber}&pageSize={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_searchText)) query += $"&search={Uri.EscapeDataString(_searchText)}";
            if (!string.IsNullOrWhiteSpace(_searchStatus)) query += $"&status={Uri.EscapeDataString(_searchStatus)}";

            var response = await SendAsync(HttpMethod.Get, "api/v1/customers" + query);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to load customers: {ExtractErrorMessage(body)}", Severity.Error);
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<PagedResult<CustomerDto>>();
            if (result is not null)
            {
                _customers = result.Items.ToList();
                _totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private int GetPageCount() => (int)Math.Ceiling((double)_totalCount / _pageSize);

    private async Task OnPageChanged(int page)
    {
        _pageNumber = page;
        await LoadCustomers();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _pageNumber = 1;
            await LoadCustomers();
        }
    }

    private void OpenEditDialog(CustomerDto customer)
    {
        _model = new CustomerFormModel
        {
            Id = customer.Id,
            PhoneNumber = customer.PhoneNumber,
            FullName = customer.FullName,
            Email = customer.Email
        };
        _showDialog = true;
    }

    private async Task SaveCustomer()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        try
        {
            var request = new { _model.FullName, _model.Email };
            var response = await SendAsync(HttpMethod.Put, $"api/v1/customers/{_model.Id}", JsonContent.Create(request));
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer updated (recorded in the audit log).", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Update failed: {ExtractErrorMessage(error)}", Severity.Error);
                return;
            }

            _showDialog = false;
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAuditDialog(CustomerDto customer)
    {
        _auditCustomerName = customer.FullName;
        _audits = null;
        _auditLoading = true;
        _showAuditDialog = true;

        try
        {
            var response = await SendAsync(HttpMethod.Get, $"api/v1/customers/{customer.Id}/audits");
            if (response.IsSuccessStatusCode)
            {
                _audits = await response.Content.ReadFromJsonAsync<List<CustomerAuditItem>>() ?? new();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to load audit history: {ExtractErrorMessage(body)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load audit history: {ex.Message}", Severity.Error);
        }
        finally
        {
            _auditLoading = false;
        }
    }

    private async Task BlacklistCustomer(CustomerDto customer)
    {
        await SetBlacklist(customer, "blacklist", "Customer blacklisted platform-wide.");
    }

    private async Task UnblacklistCustomer(CustomerDto customer)
    {
        await SetBlacklist(customer, "unblacklist", "Customer unblacklisted.");
    }

    private async Task SetBlacklist(CustomerDto customer, string action, string successMessage)
    {
        try
        {
            var response = await SendAsync(HttpMethod.Put, $"api/v1/customers/{customer.Id}/{action}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(successMessage, Severity.Success);
                await LoadCustomers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed: {ExtractErrorMessage(error)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string url, HttpContent? content = null)
    {
        var token = await AuthState.GetTokenAsync();
        var request = new HttpRequestMessage(method, url) { Content = content };
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return await Http.SendAsync(request);
    }

    private static string ExtractErrorMessage(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var error) && error.ValueKind == System.Text.Json.JsonValueKind.String)
                return error.GetString() ?? body;
        }
        catch
        {
            // not JSON - show the raw body
        }
        return body;
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Blacklisted" => Color.Error,
        _ => Color.Default
    };

    public class CustomerDto
    {
        public Guid Id { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public DateTime? UpdatedAt { get; set; }
    }

    public class PagedResult<T>
    {
        public IReadOnlyList<T> Items { get; set; } = Array.Empty<T>();
        public int TotalCount { get; set; }
        public int PageNumber { get; set; }
        public int PageSize { get; set; }
    }

    public class CustomerFormModel
    {
        public Guid Id { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
    }

    public class CustomerAuditItem
    {
        public Guid Id { get; set; }
        public Guid CustomerId { get; set; }
        public Guid? ChangedByUserId { get; set; }
        public string Field { get; set; } = string.Empty;
        public string? OldValue { get; set; }
        public string? NewValue { get; set; }
        public DateTime ChangedAt { get; set; }
    }
}

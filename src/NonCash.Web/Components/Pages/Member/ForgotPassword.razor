@page "/member/forgot-password"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Forgot Password</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8">
        @if (_sent)
        {
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Check your email</MudText>
            <MudAlert Severity="Severity.Info" Class="mb-4">@_confirmationMessage</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="GoToLogin">
                Back to Sign In
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true" Class="mt-2" OnClick="Reset">
                Use a different phone number or email
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Forgot your password?</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">
                Enter the phone number or email on your account. We will send you a sign-in link that
                works for 30 minutes — once you are in, you can choose a new password.
            </MudText>

            <MudForm @ref="_form">
                <MudTextField @bind-Value="_identifier" Label="Phone number or email" Required="true"
                              RequiredError="Enter your phone number or email" Variant="Variant.Outlined"
                              FullWidth="true" Class="mb-4" Disabled="_loading"
                              HelperText="NonCash never asks you for a username."
                              Placeholder="0913660575 or you@example.com" />
            </MudForm>

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="HandleSubmit" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Email me a sign-in link
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                Remembered it? <MudLink Href="/member-login">Sign in</MudLink>
            </MudText>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _identifier = "";
    private bool _loading = false;
    private bool _sent = false;
    private string? _errorMessage = null;
    private string? _confirmationMessage = null;

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        _loading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/member/forgot-password", new { Identifier = _identifier });
            var payload = await response.Content.ReadFromJsonAsync<MessageResponse>();

            if (response.IsSuccessStatusCode)
            {
                // The API answers the same way whether or not a link was really sent, so nobody
                // can use this page to find out who has an account.
                _confirmationMessage = payload?.message ??
                    "If an account matches that phone number or email, we have sent a sign-in link. Check your inbox and spam folder.";
                _sent = true;
                Snackbar.Add("If we found your account, the link is on its way.", Severity.Success);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                _errorMessage = payload?.error ?? "Too many attempts. Please wait a minute and try again.";
            }
            else
            {
                _errorMessage = payload?.error ??
                    "We could not send that link. Check the phone number or email you entered and try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"We could not reach the server ({ex.Message}). Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Reset()
    {
        _sent = false;
        _confirmationMessage = null;
        _errorMessage = null;
        _identifier = "";
    }

    private void GoToLogin() => Navigation.NavigateTo("/member-login", forceLoad: true);

    private class MessageResponse
    {
        public string? message { get; set; }
        public string? error { get; set; }
    }
}

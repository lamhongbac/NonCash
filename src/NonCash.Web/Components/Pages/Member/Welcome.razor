@page "/member/welcome"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Welcome to NonCash</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8">
        @if (_loading)
        {
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Verifying your link...</MudText>
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="d-flex justify-center" />
        }
        else if (_success)
        {
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Welcome, @_memberName!</MudText>
            <MudAlert Severity="Severity.Success" Class="mb-4">
                You are now signed in. If a friend sent you a voucher, accept it below — it only moves into your wallet once you do.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Redeem" OnClick="GoToGifts">
                See gifts waiting for me
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-2"
                       OnClick="GoToMyVouchers">
                View My Vouchers
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true" Class="mt-2"
                       OnClick="GoToSetPassword">
                Set a Password (optional)
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Unable to sign in</MudText>
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="GoToForgotPassword">
                Email me a new link
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true" Class="mt-2"
                       OnClick="GoToLogin">
                Go to Login
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _loading = true;
    private bool _success = false;
    private string? _errorMessage;
    private string? _memberName;

    protected override async Task OnInitializedAsync()
    {
        // Extract token from query string: /member/welcome?token=...
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var magicToken = query["token"];

        if (string.IsNullOrWhiteSpace(magicToken))
        {
            _loading = false;
            _errorMessage = "No magic link token found in the URL. Please check your email and click the link again.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/magic-link", new { Token = magicToken });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                if (result != null)
                {
                    await AuthState.LoginAsync(
                        result.Token,
                        result.User?.FullName ?? "Member",
                        result.User?.Role ?? "Member",
                        result.User?.BrandId,
                        result.User?.UserId ?? Guid.Empty,
                        result.User?.CustomerId,
                        result.ExpiresAt);

                    await AuthState.StartIdleTimerAsync();
                    _memberName = result.User?.FullName ?? "Member";
                    _success = true;
                }
                else
                {
                    _errorMessage = "Unexpected response from server.";
                }
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _errorMessage = error?.error ?? "This link is invalid, has already been used, or has expired. Ask us to email you a new one.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection error: {ex.Message}. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginResult
    {
        public string Token { get; set; } = "";
        public DateTime ExpiresAt { get; set; }
        public UserInfo? User { get; set; }
    }

    private class UserInfo
    {
        public Guid UserId { get; set; }
        public string FullName { get; set; } = "";
        public string Role { get; set; } = "";
        public Guid? BrandId { get; set; }
        public Guid? CustomerId { get; set; }
    }

    private class ErrorResponse
    {
        public string? error { get; set; }
    }

    private void GoToGifts() => Navigation.NavigateTo("/member/gifts", forceLoad: true);
    private void GoToMyVouchers() => Navigation.NavigateTo("/my-vouchers", forceLoad: true);
    private void GoToSetPassword() => Navigation.NavigateTo("/member/set-password");
    private void GoToLogin() => Navigation.NavigateTo("/member-login", forceLoad: true);
    private void GoToForgotPassword() => Navigation.NavigateTo("/member/forgot-password", forceLoad: true);
}

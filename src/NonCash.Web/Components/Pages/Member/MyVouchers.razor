@page "/my-vouchers"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject NonCash.Web.Services.ClientAuthService AuthState

@using NonCash.Shared.Helpers
@using NonCash.Shared.Enums

<PageTitle>My Vouchers</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4" Class="mb-1">My Vouchers</MudText>
        <MudText Typo="Typo.body2">Tap a voucher to see its code, terms and where you can use it.</MudText>
    </div>
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" OnClick="Reload" Disabled="_loading" />
        </MudTooltip>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CardGiftcard"
                   Disabled="@(_selectedIds.Count == 0)" OnClick="OpenGiftDialog">
            @(GiftMessageHelper.SendGiftButtonLabel + (_selectedIds.Count > 0 ? $" ({_selectedIds.Count})" : ""))
        </MudButton>
    </MudStack>
</MudStack>

@if (_loading && !_searched)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_searched && !_vouchers.Any())
{
    <MudPaper Class="pa-8 mt-4" Elevation="0" Style="text-align: center;">
        <MudIcon Icon="@Icons.Material.Outlined.CardGiftcard" Color="Color.Primary" Style="font-size: 4rem;" Class="mb-2" />
        <MudText Typo="Typo.h6" Class="mb-1">No vouchers yet</MudText>
        <MudText Typo="Typo.body2">
            Vouchers a brand sends you — or that you buy — appear here.
            <MudLink Href="/store">Browse the Voucher Store</MudLink>
        </MudText>
    </MudPaper>
}
else if (_vouchers.Any())
{
    <MudGrid>
        @foreach (var v in _vouchers)
        {
            <MudItem xs="12" sm="6" md="4">
                <VoucherCard
                    ImageUrl="@v.ImageUrl"
                    DisplayName="@v.BrandName"
                    FaceValue="@v.FaceValue"
                    ValueType="@v.ValueType"
                    ExpiryDate="@v.ExpiryDate"
                    UsageStatus="@v.UsageStatus"
                    StatusBadge="@BadgeFor(v)"
                    ShowActions="@(CanGift(v) || IsOnItsWay(v.Id))"
                    OnClick="@(() => OpenDetail(v))">
                    <ChildContent>
                        @if (CanGift(v))
                        {
                            <MudCheckBox T="bool" Value="@(_selectedIds.Contains(v.Id))" ValueChanged="@((bool b) => ToggleSelection(v.Id, b))" Label="Select to send as a gift" @onclick:stopPropagation="true" />
                        }
                        else if (IsOnItsWay(v.Id))
                        {
                            <MudText Typo="Typo.caption" Class="d-block" Style="color: #0288d1;">
                                Waiting for @PendingRecipient(v.Id) to accept
                            </MudText>
                        }
                    </ChildContent>
                </VoucherCard>
            </MudItem>
        }
    </MudGrid>
}

<MudDialog @bind-Visible="_showDetail" Options="_detailOptions">
    <TitleContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@DetailTitle</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_detail is not null)
        {
            @if (!string.IsNullOrEmpty(_detail.ImageUrl))
            {
                <MudImage Src="@VoucherCard.ResolveMediaUrl(Configuration, _detail.ImageUrl)" Alt="Voucher cover"
                          ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 180px; border-radius: 8px;" Class="mb-4" />
            }
            else
            {
                <div class="mb-4" style="height: 120px; border-radius: 8px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Size="Size.Large" Style="color: white;" />
                </div>
            }

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h5">@VoucherDisplayHelper.FormatValue(_detail.FaceValue, _detail.ValueType)</MudText>
                <MudChip T="string" Size="Size.Small" Color="@BadgeColor(DetailBadge)">@DetailBadge</MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Default" />
                <MudText Typo="Typo.body2">
                    @VoucherDisplayHelper.ComputeExpiryDisplay(_detail.ExpiryDate ?? DateTime.MaxValue)
                    @if (_detail.ExpiryDate.HasValue)
                    {
                        <span> · until @_detail.ExpiryDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(_detail.ScopeSummary))
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.Store" Size="Size.Small" Color="Color.Default" Class="mt-1" />
                    <div>
                        <MudText Typo="Typo.body2">@_detail.ScopeSummary</MudText>
                        @if (_detail.ApplicableStores.Count > 0)
                        {
                            <MudText Typo="Typo.caption">@string.Join(", ", _detail.ApplicableStores)</MudText>
                        }
                    </div>
                </MudStack>
            }

            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Description"
                       Href="@($"/terms/{_detail.Id}")" Target="_blank" Class="mb-2">
                Terms &amp; Conditions
            </MudButton>

            @if (IsOnItsWay(_detail.Id))
            {
                <MudDivider Class="my-3" />
                <MudAlert Severity="Severity.Info" Dense="true">
                    On its way to <b>@PendingRecipient(_detail.Id)</b>. It is reserved for them until
                    @PendingDeadline(_detail.Id) — the voucher cannot be used at the counter while it is waiting.
                    You can cancel it under "Gifts you sent" below and it comes straight back to your wallet.
                </MudAlert>
            }
            else if (_detail.UsageStatus is "Pending" or "InUse")
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Show this at the checkout counter</MudText>
                <VoucherBarcode SvgId="detail-voucher-barcode" Code="@_detail.VoucherCode" />
                <MudText Typo="Typo.caption" Style="font-family: monospace;">@_detail.VoucherCode</MudText>
                <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color: #ed6c02;">
                    Treat this code like cash — anyone holding it can redeem the voucher.
                </MudText>
            }
            else if (_detail.UsedDate.HasValue)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2">Used on @_detail.UsedDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDetail = false">Close</MudButton>
        @if (_detail is not null && CanGift(_detail))
        {
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CardGiftcard" OnClick="GiftFromDetail">
                @GiftMessageHelper.SendGiftButtonLabel
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showGift" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">@GiftMessageHelper.SendGiftButtonLabel</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Sending <b>@_selectedIds.Count</b> voucher(s) by phone number. Each one stays in your wallet,
            marked "@GiftMessageHelper.OnItsWayBadge", until your friend accepts it.
        </MudText>
        <MudTextField T="string" @bind-Value="_phoneList" Label="Recipient phone numbers" Lines="4" Variant="Variant.Outlined"
                      HelperText="@($"One phone per line — enter exactly {_selectedIds.Count} line(s).")" Class="mb-2" />
        <MudText Typo="Typo.caption">@_selectedIds.Count voucher(s) selected · @EnteredPhoneCount phone(s) entered</MudText>
        <MudTextField T="string" @bind-Value="_giftNote" Label="Message with your gift (optional)" Lines="2" Variant="Variant.Outlined"
                      MaxLength="280" Counter="280" Immediate="true" Class="mt-3"
                      HelperText="This note travels with every voucher in this send, and stays readable in the gift's message history." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showGift = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="ExecuteGift" Disabled="_sending">
            @if (_sending)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @GiftMessageHelper.SendGiftButtonLabel
        </MudButton>
    </DialogActions>
</MudDialog>

<MudPaper Class="pa-4 mt-6" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <div>
            <MudText Typo="Typo.h6">Gifts you sent</MudText>
            <MudText Typo="Typo.caption">Your friend has 7 days to accept. If they do not, the voucher comes back to you.</MudText>
        </div>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Inbox" Href="/member/gifts">
                Gifts from friends
            </MudButton>
            <MudTooltip Text="Refresh">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadGifts" Disabled="_loadingGifts" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    @if (_loadingGifts)
    {
        <MudProgressLinear Indeterminate="true" Class="my-2" />
    }
    else if (!_gifts.Any())
    {
        <MudText Typo="Typo.body2" Class="text-muted">No gifts sent yet. Tick a voucher above and choose "@GiftMessageHelper.SendGiftButtonLabel".</MudText>
    }
    else
    {
        <MudTable Items="_gifts" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Sent</MudTh>
                <MudTh>Voucher</MudTh>
                <MudTh>To</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>What happened</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Sent">@context.InitiatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Voucher">
                    @context.BrandName
                    <MudText Typo="Typo.caption" Class="d-block">@context.SerialNo</MudText>
                </MudTd>
                <MudTd DataLabel="To">@context.RecipientDisplayName</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GiftColor(context.Status)">@GiftMessageHelper.StatusLabel(context.Status)</MudChip>
                </MudTd>
                <MudTd DataLabel="What happened">
                    @ReplyFor(context)
                    <MudBadge Visible="@(context.UnreadCount > 0)" Content="@context.UnreadCount" Color="Color.Error" Overlap="true">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Chat" OnClick="() => OpenThread(context)">
                            @(context.MessageCount == 0 ? "Messages" : $"Messages ({context.MessageCount})")
                        </MudButton>
                    </MudBadge>
                </MudTd>
                <MudTd>
                    @if (GiftMessageHelper.IsWaiting(context.Status))
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" OnClick="() => CancelGift(context)">
                            Cancel gift
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<MudDialog @bind-Visible="_showThread" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Outlined.Chat" Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(_threadGift is null ? "Messages" : $"Messages with {_threadGift.RecipientDisplayName}")
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_threadGift is not null)
        {
            <MudText Typo="Typo.caption" Class="d-block mb-3">
                @_threadGift.BrandName · @_threadGift.SerialNo · @GiftMessageHelper.StatusLabel(_threadGift.Status)
            </MudText>
            <GiftConversation TransferId="_threadGift.TransferId" ViewerMemberId="_memberId" OnChanged="LoadGifts" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showThread = false">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private Guid _memberId;
    private bool _loading;
    private bool _searched;
    private List<MemberVoucher> _vouchers = new();
    private MemberVoucher? _detail;
    private bool _showDetail;

    // Gifting state
    private HashSet<Guid> _selectedIds = new();
    private bool _showGift;
    private bool _sending;
    private string _phoneList = string.Empty;
    private string _giftNote = string.Empty;
    private bool _loadingGifts;
    private List<GiftItem> _gifts = new();
    private Dictionary<Guid, GiftItem> _waiting = new();
    private bool _showThread;
    private GiftItem? _threadGift;
    private DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private DialogOptions _detailOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await AuthState.GetTokenAsync();
        if (AuthState.UserId.HasValue && AuthState.UserId.Value != Guid.Empty)
        {
            _memberId = AuthState.UserId.Value;
            await Reload();
        }
    }

    private string DetailTitle =>
        _detail is null || string.IsNullOrWhiteSpace(_detail.BrandName) ? "Voucher" : _detail.BrandName;

    private string DetailBadge => _detail is null ? "" : BadgeFor(_detail);

    private int EnteredPhoneCount => ParsePhones().Count;

    private static Color BadgeColor(string badge) => badge switch
    {
        "Available" => Color.Success,
        "Expiring Soon" => Color.Warning,
        "Expired" => Color.Error,
        "In Use" => Color.Info,
        GiftMessageHelper.OnItsWayBadge => Color.Info,
        _ => Color.Default
    };

    private static Color GiftColor(string status) => status switch
    {
        "PendingAcceptance" => Color.Warning,
        "Accepted" => Color.Success,
        "Rejected" => Color.Error,
        _ => Color.Default
    };

    /// <summary>Row 1: a voucher reserved for a friend keeps its card but reports where it is.</summary>
    private string BadgeFor(MemberVoucher voucher) =>
        IsOnItsWay(voucher.Id)
            ? GiftMessageHelper.OnItsWayBadge
            : VoucherDisplayHelper.ComputeStatusBadge(ParseStatus(voucher.UsageStatus), voucher.ExpiryDate ?? DateTime.MaxValue);

    private bool CanGift(MemberVoucher voucher) => voucher.UsageStatus == "Pending" && !IsOnItsWay(voucher.Id);

    private bool IsOnItsWay(Guid voucherId) => _waiting.ContainsKey(voucherId);

    private string PendingRecipient(Guid voucherId) =>
        _waiting.TryGetValue(voucherId, out var gift) ? gift.RecipientDisplayName : "your friend";

    private string PendingDeadline(Guid voucherId) =>
        _waiting.TryGetValue(voucherId, out var gift)
            ? gift.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            : "the deadline";

    private static string ReplyFor(GiftItem gift)
    {
        if (GiftMessageHelper.IsWaiting(gift.Status))
            return $"Waiting for {gift.RecipientDisplayName} — they have until {gift.ExpiresAt.ToLocalTime():dd/MM/yyyy HH:mm}.";

        return gift.Status switch
        {
            "Accepted" => string.IsNullOrWhiteSpace(gift.RecipientNote)
                ? $"{gift.RecipientDisplayName} accepted your gift."
                : $"{gift.RecipientDisplayName} accepted your gift and wrote: \"{gift.RecipientNote}\"",
            "Rejected" => string.IsNullOrWhiteSpace(gift.RejectReason)
                ? $"{gift.RecipientDisplayName} declined. The voucher is back in your wallet."
                : $"{gift.RecipientDisplayName} declined: \"{gift.RejectReason}\". The voucher is back in your wallet.",
            "Expired" => "No answer within 7 days. The voucher is back in your wallet.",
            "Cancelled" => "You cancelled this gift. The voucher stayed in your wallet.",
            _ => gift.Status
        };
    }

    private void OpenDetail(MemberVoucher voucher)
    {
        _detail = voucher;
        _showDetail = true;
    }

    private void GiftFromDetail()
    {
        if (_detail is null) return;
        _selectedIds = new HashSet<Guid> { _detail.Id };
        _showDetail = false;
        OpenGiftDialog();
    }

    private void OpenThread(GiftItem gift)
    {
        _threadGift = gift;
        _showThread = true;
    }

    private async Task Reload()
    {
        await LoadVouchers();
        await LoadGifts();
    }

    private async Task LoadVouchers()
    {
        if (_memberId == Guid.Empty)
        {
            Snackbar.Add("Please sign in as a member.", Severity.Warning);
            return;
        }

        _loading = true;
        _detail = null;
        try
        {
            var request = await CreateAuthRequestAsync(HttpMethod.Get, $"api/v1/members/{_memberId}/vouchers");
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                _vouchers = await response.Content.ReadFromJsonAsync<List<MemberVoucher>>() ?? new();
                _selectedIds.Clear();
                _searched = true;
            }
            else
            {
                await ShowApiFailureAsync("We could not load your vouchers", response);
            }
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "We could not load your vouchers",
                $"The wallet service did not answer ({ex.Message}). Check your connection, then tap Refresh.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Row 5: the sender's own gift log, straight from voucher_transfers.</summary>
    private async Task LoadGifts()
    {
        if (_memberId == Guid.Empty) return;

        _loadingGifts = true;
        try
        {
            var request = await CreateAuthRequestAsync(HttpMethod.Get, "api/v1/member/transfers/outbox?page=1&pageSize=50");
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                _gifts = await response.Content.ReadFromJsonAsync<List<GiftItem>>() ?? new();
                _waiting = _gifts
                    .Where(g => GiftMessageHelper.IsWaiting(g.Status))
                    .GroupBy(g => g.VoucherId)
                    .ToDictionary(grp => grp.Key, grp => grp.First());
            }
            else
            {
                _gifts = new();
                _waiting = new();
                await ShowApiFailureAsync("We could not load your sent gifts", response);
            }
        }
        catch
        {
            // The wallet still works without the gift log; do not block the page on it.
            _gifts = new();
            _waiting = new();
        }
        finally
        {
            _loadingGifts = false;
        }
    }

    private void ToggleSelection(Guid voucherId, bool selected)
    {
        if (selected)
            _selectedIds.Add(voucherId);
        else
            _selectedIds.Remove(voucherId);
    }

    private void OpenGiftDialog()
    {
        if (_selectedIds.Count == 0)
        {
            Snackbar.Add("Tick at least one Available voucher to send as a gift.", Severity.Warning);
            return;
        }
        _phoneList = string.Empty;
        _giftNote = string.Empty;
        _showGift = true;
    }

    private List<string> ParsePhones() =>
        (_phoneList ?? string.Empty)
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Trim())
            .Where(p => !string.IsNullOrEmpty(p))
            .ToList();

    private async Task ExecuteGift()
    {
        var phones = ParsePhones();

        if (phones.Count != _selectedIds.Count)
        {
            Snackbar.Add($"You ticked {_selectedIds.Count} voucher(s) but entered {phones.Count} phone number(s). Enter one phone per line — exactly {_selectedIds.Count} line(s).", Severity.Warning);
            return;
        }

        _sending = true;
        try
        {
            var body = new
            {
                FromMemberId = _memberId,
                VoucherIds = _selectedIds.ToList(),
                RecipientPhones = phones,
                Note = string.IsNullOrWhiteSpace(_giftNote) ? null : _giftNote.Trim()
            };
            var request = await CreateAuthRequestAsync(HttpMethod.Post, "api/v1/member/vouchers/transfer");
            request.Content = JsonContent.Create(body);

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                await ShowApiFailureAsync("No gifts were sent", response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<GiftSendResult>();
            _showGift = false;
            await Reload();
            await ShowGiftOutcomeAsync(result);
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "No gifts were sent",
                $"The gift service did not answer ({ex.Message}). Your vouchers are still in your wallet — tap Refresh and try again.",
                Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }

    /// <summary>Row 2: tell the sender exactly how each gift was delivered, one line per recipient.</summary>
    private async Task ShowGiftOutcomeAsync(GiftSendResult? result)
    {
        if (result is null)
        {
            await MessageDialog.ShowAsync(DialogService, "Gifts sent",
                "Your gifts are on their way. Open \"Gifts you sent\" below to follow each one.", Severity.Success);
            return;
        }

        var lines = new List<string>();
        foreach (var gift in result.Gifts)
        {
            lines.Add($"{GiftMessageHelper.DeliveryLabel(gift.DeliveryStatus)} — to {gift.RecipientPhone}");
            if (!string.IsNullOrWhiteSpace(gift.Message))
                lines.Add(gift.Message);
            lines.Add(string.Empty);
        }

        foreach (var skipped in result.SkippedPhones)
        {
            lines.Add(GiftMessageHelper.DescribeSkip(skipped.PhoneNumber, skipped.Reason));
            lines.Add(string.Empty);
        }

        var sent = result.Gifts.Count;
        var skippedCount = result.SkippedPhones.Count;
        var (title, severity) = (sent, skippedCount) switch
        {
            (> 0, 0) => ("Your gift is on its way", Severity.Success),
            (> 0, > 0) => ("Part of your gift went through", Severity.Warning),
            _ => ("No gifts were sent", Severity.Error)
        };

        var body = string.Join('\n', lines).Trim();
        if (body.Length == 0)
            body = $"{sent} gift(s) sent, {skippedCount} not sent. Open \"Gifts you sent\" below for the detail.";

        await MessageDialog.ShowAsync(DialogService, title, body, severity);
    }

    private async Task CancelGift(GiftItem gift)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Cancel the gift for {gift.RecipientDisplayName}? The voucher comes straight back to your wallet." }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Cancel gift", parameters, options);
        var confirm = await dialog.Result;
        if (confirm is not { Canceled: false })
            return;

        try
        {
            var request = await CreateAuthRequestAsync(HttpMethod.Post, $"api/v1/member/transfers/{gift.TransferId}/cancel");
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                await MessageDialog.ShowAsync(DialogService, "Gift cancelled",
                    $"The gift to {gift.RecipientDisplayName} was cancelled and the voucher is back in your wallet.",
                    Severity.Success);
            }
            else
            {
                await ShowApiFailureAsync("The gift was not cancelled", response);
            }
        }
        catch (Exception ex)
        {
            await MessageDialog.ShowAsync(DialogService, "The gift was not cancelled",
                $"The gift service did not answer ({ex.Message}). Tap Refresh and try again.", Severity.Error);
        }
        finally
        {
            await Reload();
        }
    }

    private async Task ShowApiFailureAsync(string title, HttpResponseMessage response)
    {
        string detail;
        try
        {
            var payload = await response.Content.ReadAsStringAsync();
            detail = string.IsNullOrWhiteSpace(payload)
                ? $"The server answered {(int)response.StatusCode}."
                : payload;
        }
        catch
        {
            detail = $"The server answered {(int)response.StatusCode}.";
        }

        await MessageDialog.ShowAsync(DialogService, title,
            $"{detail}\n\nIf this keeps happening, tap Refresh and try again.", Severity.Error);
    }

    private async Task<HttpRequestMessage> CreateAuthRequestAsync(HttpMethod method, string url)
    {
        var request = new HttpRequestMessage(method, url);
        var token = await AuthState.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return request;
    }

    private static VoucherStatus ParseStatus(string status) => status switch
    {
        "Pending" => VoucherStatus.Pending,
        "InUse" => VoucherStatus.InUse,
        "Complete" => VoucherStatus.Complete,
        _ => VoucherStatus.Pending
    };


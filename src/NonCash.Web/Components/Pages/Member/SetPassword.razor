@page "/member/set-password"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NonCash.Web.Services.ClientAuthService AuthState

<PageTitle>Set Password</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Set a Password</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-6">
            Optional: set a password so you can sign in with your phone number or email without needing a link.
        </MudText>

        @if (_notSignedIn)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Your sign-in session has ended, so a password cannot be saved from here.
                Open the link in your email again, or use Forgot password to get a new one.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="GoToForgotPassword">
                Forgot password?
            </MudButton>
        }
        else if (_saved)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Password set successfully! You can now sign in with your phone number or email and this password.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="GoToStore">
                Continue to My Vouchers
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_password" Label="New Password" InputType="InputType.Password"
                              Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                              Validation="@(new Func<string, string?>(ValidatePassword))" />
                <MudTextField @bind-Value="_confirmPassword" Label="Confirm Password" InputType="InputType.Password"
                              Variant="Variant.Outlined" FullWidth="true" Class="mb-4"
                              Validation="@(new Func<string, string?>(ValidateConfirm))" />
            </MudForm>

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="HandleSave" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Set Password
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true" Class="mt-2"
                       OnClick="SkipForNow">
                Skip for now
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _password = "";
    private string _confirmPassword = "";
    private bool _loading = false;
    private bool _saved = false;
    private bool _notSignedIn = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var token = await AuthState.GetTokenAsync();
        _notSignedIn = string.IsNullOrEmpty(token);
    }

    private string? ValidatePassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Password is required.";
        if (value.Length < 8)
            return "Password must be at least 8 characters.";
        return null;
    }

    private string? ValidateConfirm(string value)
    {
        if (value != _password)
            return "Passwords do not match.";
        return null;
    }

    private async Task HandleSave()
    {
        _errorMessage = null;

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        _loading = true;
        try
        {
            var request = await CreateAuthRequestAsync(HttpMethod.Post, "api/v1/auth/set-password");
            request.Content = JsonContent.Create(new { NewPassword = _password });
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                _saved = true;
                Snackbar.Add("Password set successfully!", MudBlazor.Severity.Success);
                return;
            }

            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized
                                     or System.Net.HttpStatusCode.Forbidden)
            {
                _errorMessage = "Your sign-in session has ended, so the password was not saved. "
                              + "Click the link in your email again, or use Forgot password?";
                return;
            }

            _errorMessage = await ReadErrorAsync(response)
                            ?? "Failed to set password. Please try again.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"We could not reach the server ({ex.Message}). Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static async Task<string?> ReadErrorAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body))
            return null;

        try
        {
            var error = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(
                body, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            return string.IsNullOrWhiteSpace(error?.error) ? null : error!.error;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private async Task<HttpRequestMessage> CreateAuthRequestAsync(HttpMethod method, string url)
    {
        var request = new HttpRequestMessage(method, url);
        var token = await AuthState.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return request;
    }

    private class ErrorResponse
    {
        public string? error { get; set; }
    }

    private void GoToStore() => Navigation.NavigateTo("/store", forceLoad: true);
    private void SkipForNow() => Navigation.NavigateTo("/store", forceLoad: true);
    private void GoToForgotPassword() => Navigation.NavigateTo("/member/forgot-password", forceLoad: true);
}
